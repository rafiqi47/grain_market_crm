<% content_for :title, "Statement — #{@trading_partner.business_name}" %>

<!-- Header -->
<div class="flex items-start justify-between border-b border-gray-300 pb-4 mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Trading Partner Statement</h1>
    <p class="text-sm text-gray-500 mt-1">Generated on <%= Date.current.strftime("%d %b %Y") %></p>
  </div>
  <div class="text-right">
    <p class="text-lg font-bold text-gray-900">Grain CRM</p>
    <p class="text-xs text-gray-500"><%= current_user.organization.name %></p>
  </div>
</div>

<!-- Partner Info -->
<div class="grid grid-cols-2 gap-6 mb-6">
  <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
    <p class="text-xs font-semibold text-gray-500 uppercase mb-2">Partner Details</p>
    <p class="font-bold text-gray-900 text-lg"><%= @trading_partner.business_name.titleize %></p>
    <% if @trading_partner.contact_person.present? %>
      <p class="text-sm text-gray-600"><%= @trading_partner.contact_person %></p>
    <% end %>
    <p class="text-sm text-gray-600"><%= @trading_partner.primary_phone %></p>
    <% if @trading_partner.secondary_phone.present? %>
      <p class="text-sm text-gray-600"><%= @trading_partner.secondary_phone %></p>
    <% end %>
    <p class="text-sm text-gray-600 mt-1"><%= @trading_partner.address %></p>
  </div>

  <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
    <p class="text-xs font-semibold text-gray-500 uppercase mb-2">Current Position</p>
    <p class="text-2xl font-bold <%= @trading_partner.current_balance.negative? ? 'text-green-700' : 'text-red-600' %>">
      Rs. <%= number_with_delimiter(@trading_partner.current_balance.abs.round(2)) %>
    </p>
    <p class="text-sm text-gray-500"><%= @trading_partner.current_balance.negative? ? "They owe us" : "We owe them" %></p>
    <p class="text-sm text-gray-600 mt-2">Bardaana: <span class="font-medium"><%= @trading_partner.bardaana_balance %> bags</span>
      <%= @trading_partner.bardaana_balance > 0 ? "(they owe us)" : @trading_partner.bardaana_balance < 0 ? "(we owe them)" : "(settled)" %>
    </p>
  </div>
</div>

<!-- Ledger -->
<div class="mb-8">
  <h2 class="text-base font-bold text-gray-900 mb-2 border-b border-gray-200 pb-1">
    Ledger History
  </h2>

  <table class="min-w-full text-sm border border-gray-200 rounded-lg overflow-hidden">
    <thead class="bg-gray-100">
      <tr>
        <th class="px-3 py-2 text-left text-xs font-semibold text-gray-600 uppercase">Date</th>
        <th class="px-3 py-2 text-left text-xs font-semibold text-gray-600 uppercase">Description</th>
        <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600 uppercase">Credit</th>
        <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600 uppercase">Debit</th>
        <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600 uppercase">Balance</th>
        <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600 uppercase">Bags</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% if @ledger_entries.any? %>
        <% @ledger_entries.each do |entry| %>
          <tr>
            <td class="px-3 py-2 text-gray-500"><%= entry.created_at.strftime("%d %b %Y") %></td>
            <td class="px-3 py-2 text-gray-700"><%= entry.description %></td>
            <td class="px-3 py-2 text-right text-green-700"><%= "Rs. #{number_with_delimiter(entry.amount.round(2))}" if entry.credit? %></td>
            <td class="px-3 py-2 text-right text-red-600"><%= "Rs. #{number_with_delimiter(entry.amount.round(2))}" if entry.debit? %></td>
            <td class="px-3 py-2 text-right font-medium text-gray-900">Rs. <%= number_with_delimiter(entry.resulting_balance.round(2)) %></td>
            <td class="px-3 py-2 text-right text-gray-600">
              <% if entry.bardaana_debit > 0 %>
                <span class="text-orange-600">-<%= entry.bardaana_debit %> bags</span>
              <% elsif entry.bardaana_credit > 0 %>
                <span class="text-blue-600">+<%= entry.bardaana_credit %> bags</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="6" class="px-3 py-4 text-center text-gray-400">No ledger entries yet.</td>
        </tr>
      <% end %>
    </tbody>
    <tfoot class="bg-gray-50 border-t border-gray-200">
      <tr>
        <td colspan="4" class="px-3 py-2 text-sm font-semibold text-gray-700">Closing Balance</td>
        <td class="px-3 py-2 text-right font-bold <%= @trading_partner.current_balance.negative? ? 'text-green-700' : 'text-red-600' %>">
          Rs. <%= number_with_delimiter(@trading_partner.current_balance.abs.round(2)) %>
        </td>
        <td class="px-3 py-2 text-right font-medium text-gray-700"><%= @trading_partner.bardaana_balance %> bags</td>
      </tr>
    </tfoot>
  </table>
</div>

<!-- Crop Sales -->
<% if @crop_sales.any? %>
  <div class="mb-8">
    <h2 class="text-base font-bold text-gray-900 mb-2 border-b border-gray-200 pb-1">
      Crop Sales
    </h2>

    <table class="min-w-full text-sm border border-gray-200 rounded-lg overflow-hidden">
      <thead class="bg-gray-100">
        <tr>
          <th class="px-3 py-2 text-left text-xs font-semibold text-gray-600 uppercase">Date</th>
          <th class="px-3 py-2 text-left text-xs font-semibold text-gray-600 uppercase">Crop</th>
          <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600 uppercase">Weight</th>
          <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600 uppercase">Rate/Maund</th>
          <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600 uppercase">Total</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @crop_sales.each do |sale| %>
          <tr>
            <td class="px-3 py-2 text-gray-500"><%= sale.sale_date.strftime("%d %b %Y") %></td>
            <td class="px-3 py-2 text-gray-700"><%= sale.crop.name %></td>
            <td class="px-3 py-2 text-right text-gray-700"><%= sale.weight_formatted %></td>
            <td class="px-3 py-2 text-right text-gray-700">Rs. <%= number_with_delimiter(sale.rate.round(2)) %></td>
            <td class="px-3 py-2 text-right font-medium text-gray-900">Rs. <%= number_with_delimiter(sale.total_value.round(2)) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="bg-gray-50 border-t border-gray-200">
        <tr>
          <td colspan="4" class="px-3 py-2 text-sm font-semibold text-gray-700">Total Crop Sales</td>
          <td class="px-3 py-2 text-right font-bold text-gray-900">
            Rs. <%= number_with_delimiter(@crop_sales.sum(&:total_value).round(2)) %>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>
<% end %>

<!-- Product Sales -->
<% if @sales_orders.any? %>
  <div class="mb-8">
    <h2 class="text-base font-bold text-gray-900 mb-2 border-b border-gray-200 pb-1">
      Product Sales on Credit
    </h2>

    <table class="min-w-full text-sm border border-gray-200 rounded-lg overflow-hidden">
      <thead class="bg-gray-100">
        <tr>
          <th class="px-3 py-2 text-left text-xs font-semibold text-gray-600 uppercase">Order #</th>
          <th class="px-3 py-2 text-left text-xs font-semibold text-gray-600 uppercase">Date</th>
          <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600 uppercase">Amount</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @sales_orders.each do |order| %>
          <tr>
            <td class="px-3 py-2 font-mono text-gray-700"><%= order.order_number %></td>
            <td class="px-3 py-2 text-gray-500"><%= order.placed_at.strftime("%d %b %Y") %></td>
            <td class="px-3 py-2 text-right font-medium text-red-600">Rs. <%= number_with_delimiter(order.total_revenue.round(2)) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="bg-gray-50 border-t border-gray-200">
        <tr>
          <td colspan="2" class="px-3 py-2 text-sm font-semibold text-gray-700">Total Product Sales</td>
          <td class="px-3 py-2 text-right font-bold text-red-600">
            Rs. <%= number_with_delimiter(@sales_orders.sum(&:total_revenue).round(2)) %>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>
<% end %>

<!-- Footer -->
<div class="border-t border-gray-300 pt-4 mt-8 text-xs text-gray-400 flex justify-between">
  <span>This statement was generated by Grain CRM — <%= current_user.organization.name %></span>
  <span>Printed on <%= Time.current.strftime("%d %b %Y, %I:%M %p") %></span>
</div>
