<div class="max-w-5xl mx-auto py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold text-gray-900">Trading Partners</h1>
    <%= link_to "Add Trading Partner", new_trading_partner_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-md py-2 px-4" %>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Business Name</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Contact</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Phone</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Balance</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Bardaana</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @trading_partners.each do |partner| %>
          <tr class="hover:bg-gray-50 cursor-pointer" onclick="window.location='<%= trading_partner_path(partner) %>'">
            <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= partner.business_name.titleize %></td>
            <td class="px-4 py-3 text-sm text-gray-500"><%= partner.contact_person %></td>
            <td class="px-4 py-3 text-sm text-gray-500"><%= partner.primary_phone %></td>
            <td class="px-4 py-3 text-sm text-right font-medium <%= partner.current_balance.negative? ? 'text-green-700' : 'text-red-600' %>">
              Rs. <%= number_with_delimiter(partner.current_balance.abs.round(2)) %>
              <span class="text-xs text-gray-400"><%= partner.current_balance.negative? ? "(they owe us)" : "(we owe them)" %></span>
            </td>
            <td class="px-4 py-3 text-sm text-right text-gray-600"><%= partner.bardaana_balance %> bags</td>
          </tr>
        <% end %>

        <% if @trading_partners.empty? %>
          <tr><td colspan="5" class="px-4 py-8 text-center text-gray-400 text-sm">No trading partners added yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
