<div class="max-w-3xl mx-auto py-8">
  <div class="flex items-start justify-between mb-6">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900"><%= @trading_partner.business_name.titleize %></h1>
      <p class="text-gray-500 text-sm mt-1">
        <%= @trading_partner.contact_person %><%= " · #{@trading_partner.primary_phone}" if @trading_partner.primary_phone.present? %>
      </p>
      <p class="text-gray-500 text-sm"><%= @trading_partner.address %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_trading_partner_path(@trading_partner), class: "bg-white border border-gray-300 text-gray-700 font-medium rounded-md py-2 px-4 text-sm" %>
      <%= link_to "Print Statement", statement_trading_partner_path(@trading_partner), target: "_blank", class: "bg-white border border-gray-300 text-gray-700 font-medium rounded-md py-2 px-4 text-sm" %>
      <%= link_to "Record Crop Sale", new_trading_partner_crop_sale_path(@trading_partner), class: "bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-md py-2 px-4 text-sm" %>
      <%= link_to "Add Ledger Entry", new_trading_partner_trading_partner_ledger_path(@trading_partner), class: "bg-gray-800 hover:bg-gray-900 text-white font-medium rounded-md py-2 px-4 text-sm" %>
    </div>
  </div>

  <!-- Balance Summary -->
  <div class="grid grid-cols-2 gap-4 mb-6">
    <div class="bg-white border border-gray-200 rounded-lg p-5">
      <p class="text-xs text-gray-500 uppercase font-medium">Current Balance</p>
      <p class="text-2xl font-semibold mt-1 <%= @trading_partner.current_balance.negative? ? 'text-green-700' : 'text-red-600' %>">
        Rs. <%= number_with_delimiter(@trading_partner.current_balance.abs.round(2)) %>
      </p>
      <p class="text-xs text-gray-400 mt-1"><%= @trading_partner.current_balance.negative? ? "They owe us" : "We owe them" %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg p-5">
      <p class="text-xs text-gray-500 uppercase font-medium">Bardaana Balance</p>
      <p class="text-2xl font-semibold mt-1 text-gray-900"><%= @trading_partner.bardaana_balance %> bags</p>
      <p class="text-xs text-gray-400 mt-1"><%= @trading_partner.bardaana_balance.positive? ? "They owe us bags" : @trading_partner.bardaana_balance.negative? ? "We owe them bags" : "Settled" %></p>
    </div>
  </div>

  <!-- Ledger -->
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-4 py-3 border-b border-gray-200">
      <h2 class="font-medium text-gray-900">Ledger</h2>
    </div>

    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
          <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Credit</th>
          <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Debit</th>
          <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Balance</th>
          <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Bags</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @ledger_entries.each do |entry| %>
          <tr>
            <td class="px-4 py-2 text-sm text-gray-500"><%= entry.created_at.strftime("%d %b %Y") %></td>
            <td class="px-4 py-2 text-sm text-gray-700"><%= entry.description %></td>
            <td class="px-4 py-2 text-sm text-right text-green-700"><%= "Rs. #{number_with_delimiter(entry.amount.round(2))}" if entry.credit? %></td>
            <td class="px-4 py-2 text-sm text-right text-red-600"><%= "Rs. #{number_with_delimiter(entry.amount.round(2))}" if entry.debit? %></td>
            <td class="px-4 py-2 text-sm text-right font-medium text-gray-900">Rs. <%= number_with_delimiter(entry.resulting_balance.round(2)) %></td>
            <td class="px-4 py-2 text-sm text-right text-gray-600">
              <% if entry.bardaana_debit > 0 %>
                <span class="text-orange-600">-<%= entry.bardaana_debit %> bags</span>
              <% elsif entry.bardaana_credit > 0 %>
                <span class="text-blue-600">+<%= entry.bardaana_credit %> bags</span>
              <% end %>
            </td>
            <td class="px-4 py-2 text-right">
              <% if entry.sourceable_type == "TradingPartnerLedger" || entry.sourceable_id.nil? %>
                <%= link_to "Edit", edit_trading_partner_trading_partner_ledger_path(@trading_partner, entry), class: "text-xs text-gray-400 hover:text-gray-700" %>
              <% end %>
            </td>
          </tr>
        <% end %>

        <% if @ledger_entries.empty? %>
          <tr><td colspan="6" class="px-4 py-6 text-center text-gray-400 text-sm">No ledger entries yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Sales Orders -->
  <% partner_orders = @trading_partner.sales_orders.order(placed_at: :desc) %>
  <% if partner_orders.any? %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mt-6">
      <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
        <h2 class="font-medium text-gray-900">Product Sales (on credit)</h2>
        <%= link_to "New Sale", new_sales_order_path, class: "text-sm bg-gray-800 hover:bg-gray-900 text-white rounded-md py-1.5 px-3" %>
      </div>

      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Order #</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
            <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Amount</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% partner_orders.each do |order| %>
            <tr class="hover:bg-gray-50 cursor-pointer" onclick="window.location='<%= sales_order_path(order) %>'">
              <td class="px-4 py-2 text-sm font-mono text-gray-700"><%= order.order_number %></td>
              <td class="px-4 py-2 text-sm text-gray-500"><%= order.placed_at.strftime("%d %b %Y") %></td>
              <td class="px-4 py-2 text-sm text-right font-medium text-red-600">Rs. <%= number_with_delimiter(order.total_revenue.round(2)) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
