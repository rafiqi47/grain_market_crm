<% if ledger_entry.errors.any? %>
  <div class="bg-red-50 border border-red-200 text-red-700 rounded-md p-4 mb-6">
    <ul class="list-disc list-inside text-sm">
      <% ledger_entry.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [trading_partner, ledger_entry] do |f| %>
  <div class="space-y-4 bg-white border border-gray-200 rounded-lg p-6">

    <div>
      <%= f.label :entry_type, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :entry_type,
            [["Credit — we owe them more (e.g. they supplied us goods)", :credit],
             ["Debit — we owe them less (e.g. we paid them cash)", :debit]],
            {}, class: "w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :amount, "Amount (Rs.)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :amount, min: 0, step: 0.01, class: "w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <fieldset class="border border-gray-200 rounded-md p-4">
      <legend class="text-sm font-medium text-gray-700 px-1">Bardaana Adjustment (optional)</legend>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <%= f.label :bardaana_debit, "Bags we gave them (they owe us)", class: "block text-xs text-gray-500 mb-1" %>
          <%= f.number_field :bardaana_debit, min: 0, step: 1, value: ledger_entry.bardaana_debit || 0, class: "w-full rounded-md border-gray-300 shadow-sm" %>
        </div>
        <div>
          <%= f.label :bardaana_credit, "Bags returned to us (clears their debt)", class: "block text-xs text-gray-500 mb-1" %>
          <%= f.number_field :bardaana_credit, min: 0, step: 1, value: ledger_entry.bardaana_credit || 0, class: "w-full rounded-md border-gray-300 shadow-sm" %>
        </div>
      </div>
      <p class="text-xs text-gray-400 mt-2">Current bardaana balance: <span class="font-medium"><%= @trading_partner.bardaana_balance %> bags</span> <%= @trading_partner.bardaana_balance > 0 ? "(they owe us)" : @trading_partner.bardaana_balance < 0 ? "(we owe them)" : "(settled)" %></p>
    </fieldset>

    <div>
      <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :description, placeholder: "e.g. Cash payment via bank transfer", class: "w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <%= f.submit class: "w-full bg-gray-800 hover:bg-gray-900 text-white font-medium rounded-md py-2 px-4 cursor-pointer" %>
  </div>
<% end %>
