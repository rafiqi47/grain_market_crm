<div class="space-y-6 p-6">
  <div class="flex items-center justify-between">
    <%= link_to "← Back to Sales Orders", sales_orders_path, class: "text-sm text-gray-500 hover:text-gray-700 font-medium transition" %>
    <div class="flex items-center space-x-3">
      <%= link_to "Modify Order", edit_sales_order_path(@sales_order), class: "text-xs font-bold bg-blue-50 text-blue-700 px-3 py-1.5 rounded border border-blue-200 hover:bg-blue-100 transition" %>
      <span class="text-xs text-gray-400 font-mono">ID: <%= @sales_order.id %></span>
    </div>
  </div>

  <div class="bg-white shadow rounded-lg p-6 border border-gray-200 space-y-6">
    <!-- Header Summary Block -->
    <div class="border-b border-gray-100 pb-4 flex justify-between items-start">
      <div>
        <h1 class="text-2xl font-black text-gray-900 font-mono"><%= @sales_order.order_number %></h1>
        <p class="text-sm text-gray-500 mt-1">Customer: <strong class="text-gray-800"><%= @sales_order.customer_name %></strong></p>
      </div>
      <div class="text-right">
        <span class="text-xs text-gray-400 block font-medium uppercase tracking-wider">Processed Stamp</span>
        <span class="text-sm text-gray-700 font-semibold"><%= @sales_order.placed_at.strftime("%B %d, %Y %H:%M") %></span>
      </div>
    </div>

    <!-- Allocation Ledger Mapping -->
    <div>
      <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">Allocated Line Items Manifest</h3>
      <div class="overflow-hidden border border-gray-100 rounded-md">
        <table class="min-w-full divide-y divide-gray-100 text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-2.5 text-left font-semibold text-gray-600">Product Name</th>
              <th class="px-4 py-2.5 text-left font-semibold text-gray-600">Fulfillment Lot (Batch)</th>
              <th class="px-4 py-2.5 text-right font-semibold text-gray-600">Quantity Ordered</th>
              <th class="px-4 py-2.5 text-right font-semibold text-gray-600">Unit Price</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white text-gray-700">
            <% grand_total = 0 %>
            <% @sales_order.sales_line_items.includes(product_batch: :product).each do |item| %>
              <% line_total = item.quantity * item.unit_price %>
              <% grand_total += line_total %>
              <tr>
                <td class="px-4 py-3 font-semibold text-gray-900"><%= item.product_batch.product.name %></td>
                <td class="px-4 py-3 font-mono text-xs">
                  <span class="bg-gray-100 text-gray-800 px-2 py-0.5 rounded">
                    Lot: <%= item.product_batch.batch_number %>
                  </span>
                </td>
                <td class="px-4 py-3 text-right font-medium"><%= item.quantity %> units</td>
                <td class="px-4 py-3 text-right font-mono text-gray-500"><%= number_to_currency(item.unit_price, unit: "") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Grand Total Footer Section -->
    <div class="flex justify-end pt-4 border-t border-gray-100">
      <div class="w-64 space-y-1.5 text-right">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Order Total</div>
        <div class="text-xl font-black text-gray-950 tracking-tight font-mono">
          <%= number_to_currency(grand_total) %>
        </div>
      </div>
    </div>
  </div>
</div>
