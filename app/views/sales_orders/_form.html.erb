<% sales_order ||= SalesOrder.new %>

<div class="my-8 px-4 sm:px-6">
  <div class="md:flex md:items-center md:justify-between mb-8 border-b border-gray-200 pb-5">
    <div class="flex-1 min-w-0">
      <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate tracking-tight">
        <%= sales_order.persisted? ? "Edit Outbound Sales Order" : "Create Outbound Sales Order" %>
      </h2>
      <% if sales_order.persisted? %>
        <p class="mt-1 text-sm text-gray-500 font-mono">
          Manifest Designation: <span class="bg-gray-100 px-2 py-0.5 rounded text-gray-700 font-bold"><%= sales_order.order_number %></span>
        </p>
      <% end %>
    </div>
    <div class="mt-4 flex md:mt-0 md:ml-4">
      <%= link_to sales_orders_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors" do %>
        <svg class="-ml-1 mr-2 h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
        </svg>
        Back to Orders
      <% end %>
    </div>
  </div>

  <%= form_with url: url, method: method, local: true, class: "space-y-8" do |f| %>
    <div class="bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl">
      <div class="px-4 py-6 sm:p-8">
        <div class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-6" data-controller="customer-type">

          <!-- Customer Type Selector -->
          <div class="sm:col-span-4">
            <label class="block text-sm font-semibold leading-6 text-gray-900">Customer Type</label>
            <div class="mt-2">
              <select name="customer_type"
                      data-customer-type-target="typeSelect"
                      data-action="change->customer-type#toggle"
                      class="block w-full rounded-lg border-0 p-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-green-600 sm:text-sm sm:leading-6">
                <option value="walk_in" <%= "selected" if (params[:customer_type] || sales_order.customer_type) == "walk_in" %>>Walk-in / Cash Customer</option>
                <option value="farmer_customer" <%= "selected" if (params[:customer_type] || sales_order.customer_type) == "farmer_customer" %>>Farmer (credit to Khata)</option>
                <option value="trading_partner_customer" <%= "selected" if (params[:customer_type] || sales_order.customer_type) == "trading_partner_customer" %>>Trading Partner (credit to Ledger)</option>
              </select>
            </div>
          </div>

          <!-- Walk-in: free text name -->
          <div class="sm:col-span-4" data-customer-type-target="customerNameSection">
            <label class="block text-sm font-semibold leading-6 text-gray-900">Customer Name</label>
            <div class="mt-2">
              <input type="text"
                     name="customer_name"
                     value="<%= params[:customer_name] || sales_order.customer_name %>"
                     placeholder="e.g., Habib Grains Ltd. / Al-Murtaza Millers"
                     class="block w-full rounded-lg border-0 p-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-green-600 sm:text-sm sm:leading-6 transition">
            </div>
          </div>

          <!-- Farmer dropdown -->
          <div class="sm:col-span-4 hidden" data-customer-type-target="farmerSection">
            <label class="block text-sm font-semibold leading-6 text-gray-900">Select Farmer</label>
            <div class="mt-2">
              <select name="farmer_id"
                      class="block w-full rounded-lg border-0 p-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-green-600 sm:text-sm sm:leading-6">
                <option value="">-- Select Farmer --</option>
                <% (@farmers || []).each do |farmer| %>
                  <option value="<%= farmer.id %>"
                          <%= "selected" if (params[:farmer_id] || sales_order.farmer_id).to_s == farmer.id.to_s %>>
                    <%= farmer.full_name %> — Balance: Rs. <%= number_with_delimiter(farmer.current_balance.abs.round(2)) %>
                  </option>
                <% end %>
              </select>
            </div>
          </div>

          <!-- Trading Partner dropdown -->
          <div class="sm:col-span-4 hidden" data-customer-type-target="tradingPartnerSection">
            <label class="block text-sm font-semibold leading-6 text-gray-900">Select Trading Partner</label>
            <div class="mt-2">
              <select name="trading_partner_id"
                      class="block w-full rounded-lg border-0 p-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-green-600 sm:text-sm sm:leading-6">
                <option value="">-- Select Trading Partner --</option>
                <% (@trading_partners || []).each do |partner| %>
                  <option value="<%= partner.id %>"
                          <%= "selected" if (params[:trading_partner_id] || sales_order.trading_partner_id).to_s == partner.id.to_s %>>
                    <%= partner.business_name.titleize %> — Balance: Rs. <%= number_with_delimiter(partner.current_balance.abs.round(2)) %>
                  </option>
                <% end %>
              </select>
            </div>
          </div>

        </div>
      </div>
    </div>

    <div class="bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl">
      <div class="border-b border-gray-200 px-4 py-5 sm:px-8 flex justify-between items-center bg-gray-50 sm:rounded-t-xl">
        <div>
          <h3 class="text-base font-semibold leading-6 text-gray-900">Line Items Manifest</h3>
          <p class="mt-1 text-sm text-gray-500">Add physical inventory allocations and select dynamic FIFO options or specific tracking lots.</p>
        </div>
        <button type="button" id="add-item-btn" class="inline-flex items-center px-3.5 py-2 border border-transparent text-sm font-semibold rounded-lg shadow-sm text-white bg-gray-900 hover:bg-gray-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 transition-colors">
          <svg class="-ml-0.5 mr-1.5 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Add Line Item
        </button>
      </div>

      <div class="p-4 sm:p-8 space-y-4">
        <div id="items-container" class="space-y-4">
          <% current_items = @submitted_items&.values || (sales_order.persisted? ? @line_items : [SalesLineItem.new]) %>
          <% current_items.each_with_index do |item, idx| %>
            <%= render partial: "sales_orders/item_row", locals: { idx: idx, item: item } %>
          <% end %>
        </div>

        <div id="empty-state-placeholder" class="hidden text-center py-12 border-2 border-dashed border-gray-300 rounded-xl bg-gray-50">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
          </svg>
          <h3 class="mt-2 text-sm font-semibold text-gray-900">No line items added</h3>
          <p class="mt-1 text-sm text-gray-500">Get started by adding an item row to this outbound manifest transaction.</p>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-end gap-x-4 border-t border-gray-900/10 pt-6">
      <%= f.submit "Save Transaction", class: "rounded-lg bg-green-600 px-5 py-3 text-sm font-semibold text-white shadow-md hover:bg-green-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600 transition-all cursor-pointer" %>
    </div>
  <% end %>
</div>

<template id="item-row-template">
  <%= render partial: "sales_orders/item_row", locals: { idx: "INDEX", item: nil } %>
</template>

<script>
  document.addEventListener("turbo:load", function() {
    const container  = document.getElementById("items-container");
    const addButton  = document.getElementById("add-item-btn");
    const template   = document.getElementById("item-row-template");
    const emptyState = document.getElementById("empty-state-placeholder");

    if (!container || !addButton || !template) return;

    const freshAddButton = addButton.cloneNode(true);
    addButton.parentNode.replaceChild(freshAddButton, addButton);

    // ── Inventory data: unit + batches with packageSize ─────────────
    const inventoryData = {
      <% (@products || []).each do |product| %>
        "<%= product.id %>": {
          unit: "<%= product.unit %>",
          batches: [
            <% product.product_batches.active.each do |batch| %>
              {
                id: "<%= batch.id %>",
                packageSize: <%= batch.package_size.to_f %>,
                label: "Lot: <%= escape_javascript(batch.batch_number.to_s) %> <%= escape_javascript(batch.available_batch_details) %>"
              },
            <% end %>
          ]
        },
      <% end %>
    };

    const PACKET_UNITS = ["ml", "gram"];

    // ── Label maps ───────────────────────────────────────────────────
    const QTY_LABELS = {
      ml:    "Qty (bottles)",   gram:  "Qty (packets)",
      bag:   "Qty (bags)",      piece: "Qty (pieces)",
      kg:    "Qty (KG)"
    };
    const PRICE_LABELS = {
      ml:    "Price / bottle (Rs.)",  gram:  "Price / packet (Rs.)",
      bag:   "Price / bag (Rs.)",     piece: "Price / piece (Rs.)",
      kg:    "Price / KG (Rs.)"
    };

    // ── Helpers ──────────────────────────────────────────────────────
    function toggleSubmitButton() {
      const btn      = document.querySelector('input[type="submit"]');
      const rowCount = container.querySelectorAll(".item-row").length;
      if (btn) {
        btn.disabled      = rowCount === 0;
        btn.style.opacity = rowCount === 0 ? "0.5" : "1";
        btn.style.cursor  = rowCount === 0 ? "not-allowed" : "pointer";
      }
      if (emptyState) emptyState.classList.toggle("hidden", rowCount > 0);
    }

    function setupRow(row) {
      if (!row) return;
      const removeBtn = row.querySelector(".remove-item-btn");
      if (removeBtn) {
        removeBtn.addEventListener("click", function(e) {
          e.preventDefault();
          row.remove();
          reindexRows();
          toggleSubmitButton();
        });
      }
    }

    function updateLabels(row, unit) {
      const qtyLabel   = row.querySelector(".qty-label");
      const priceLabel = row.querySelector(".price-label");
      if (qtyLabel)   qtyLabel.textContent   = QTY_LABELS[unit]   || "Qty";
      if (priceLabel) priceLabel.textContent = PRICE_LABELS[unit]  || "Price (Rs.)";
    }

    // ── Step 1: populate package sizes when product changes ──────────
    function filterPackageSizes(row, isInitialLoad = false) {
      if (!row) return;
      const productSelect      = row.querySelector(".product-select");
      const packageSizeWrapper = row.querySelector(".package-size-wrapper");
      const packageSizeSelect  = row.querySelector(".package-size-select");
      const batchSelect        = row.querySelector(".batch-select");
      if (!productSelect || !packageSizeWrapper || !packageSizeSelect) return;

      const productId   = productSelect.value;
      const productData = inventoryData[productId];
      const unit        = productData?.unit || "";

      // Update qty/price labels
      if (unit) updateLabels(row, unit);

      // Non-packet: hide package size, return
      if (!productData || !PACKET_UNITS.includes(unit)) {
        packageSizeWrapper.classList.add("hidden");
        return;
      }

      // Distinct sizes from active batches
      const sizes = [...new Set(
        productData.batches.map(b => b.packageSize).filter(s => s > 0)
      )].sort((a, b) => a - b);

      const prevSize = packageSizeSelect.getAttribute("data-selected-size");
      const unitWord = unit === "ml" ? "bottle" : "packet";

      packageSizeSelect.innerHTML = `<option value="">-- Select ${unitWord} size --</option>`;
      sizes.forEach(size => {
        const opt       = document.createElement("option");
        opt.value       = size;
        opt.textContent = `${size} ${unit}`;
        if (isInitialLoad && String(prevSize) === String(size)) opt.selected = true;
        packageSizeSelect.appendChild(opt);
      });

      packageSizeWrapper.classList.remove("hidden");

      // If no size selected yet, clear batch select
      if (!packageSizeSelect.value && batchSelect) {
        batchSelect.innerHTML = `<option value="">Select a ${unitWord} size first</option>`;
      }
    }

    // ── Step 2: populate batches when product (or package size) changes
    function filterBatches(row, isInitialLoad = false) {
      if (!row) return;
      const productSelect     = row.querySelector(".product-select");
      const batchSelect       = row.querySelector(".batch-select");
      const packageSizeSelect = row.querySelector(".package-size-select");
      if (!productSelect || !batchSelect) return;

      const productId      = productSelect.value;
      const productData    = inventoryData[productId];
      const prevSelectedId = batchSelect.getAttribute("data-selected-id");

      if (!productData) {
        batchSelect.innerHTML = '<option value="">Automated FIFO (Oldest First)</option>';
        return;
      }

      const unit     = productData.unit || "";
      const isPacket = PACKET_UNITS.includes(unit);

      let batchesToShow = productData.batches;

      if (isPacket) {
        const selectedSize = parseFloat(packageSizeSelect?.value);
        if (!selectedSize || selectedSize <= 0) {
          // No package size chosen yet
          batchSelect.innerHTML = `<option value="">Select a size first</option>`;
          return;
        }
        // Filter to matching package size only
        batchesToShow = productData.batches.filter(b => b.packageSize === selectedSize);
        batchSelect.innerHTML = `<option value="">Automated FIFO (${selectedSize}${unit}, oldest first)</option>`;
      } else {
        batchSelect.innerHTML = '<option value="">Automated FIFO (Oldest First)</option>';
      }

      batchesToShow.forEach(batch => {
        const opt       = document.createElement("option");
        opt.value       = batch.id;
        opt.textContent = batch.label;
        if (isInitialLoad && String(prevSelectedId) === String(batch.id)) opt.selected = true;
        batchSelect.appendChild(opt);
      });
    }

    function reindexRows() {
      container.querySelectorAll(".item-row").forEach((row, newIdx) => {
        row.querySelectorAll("[name]").forEach(el => {
          el.name = el.name.replace(/items\[\d+\]|items\[INDEX\]/, `items[${newIdx}]`);
        });
      });
    }

    // ── Initialize existing rows (edit form re-population) ───────────
    container.querySelectorAll(".item-row").forEach(row => {
      filterPackageSizes(row, true);
      filterBatches(row, true);
      setupRow(row);
    });

    // ── Delegated change handler ─────────────────────────────────────
    container.addEventListener("change", (e) => {
      const row = e.target.closest(".item-row");
      if (!row) return;

      if (e.target.classList.contains("product-select")) {
        filterPackageSizes(row);
        filterBatches(row);
      }
      if (e.target.classList.contains("package-size-select")) {
        filterBatches(row);
      }
    });

    // ── Add new row ──────────────────────────────────────────────────
    freshAddButton.addEventListener("click", function(event) {
      event.preventDefault();
      const index = container.querySelectorAll(".item-row").length;
      let clone   = template.content.cloneNode(true);

      let rootEl = clone.querySelector(".item-row") || clone.firstElementChild;
      if (rootEl && !rootEl.classList.contains("item-row")) {
        rootEl.classList.add("item-row");
      }

      clone.querySelectorAll("[name]").forEach(el => {
        el.name = el.name.replace("INDEX", index);
      });

      setupRow(rootEl);
      container.appendChild(clone);

      const newRow = container.lastElementChild;
      filterPackageSizes(newRow);
      filterBatches(newRow);
      reindexRows();
      toggleSubmitButton();
    });

    toggleSubmitButton();
  });
</script>

