<div class="space-y-6 p-6">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-black text-gray-900 tracking-tight">Sales Orders</h1>
      <p class="text-sm text-gray-500">Outbound fulfillment logs and stock allocation history.</p>
    </div>
    <%= link_to "New Fulfillment Order", new_sales_order_path, class: "bg-green-600 hover:bg-green-700 text-white font-bold py-2.5 px-5 rounded-lg shadow-md text-sm transition" %>
  </div>

  <div class="bg-white shadow rounded-lg overflow-hidden border border-gray-200">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Order Date</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Order Number</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Customer Name</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Items Flagged</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200 text-sm text-gray-700">
        <% @sales_orders.each do |order| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-gray-400"><%= order.placed_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td class="px-6 py-4 whitespace-nowrap font-mono font-bold text-gray-900"><%= order.order_number %></td>
            <td class="px-6 py-4 whitespace-nowrap font-medium"><%= order.customer_name %></td>
            <td class="px-6 py-4 whitespace-nowrap text-gray-500"><%= order.sales_line_items.count %> distinct items</td>
            <td class="px-6 py-4 whitespace-nowrap">
              <%= link_to "View Breakdown", sales_order_path(order), class: "text-green-600 hover:text-green-700 font-semibold underline transition" %>
              <%= button_to "Delete", sales_order_path(order), 
                method: :delete, 
                form: { data: { turbo_confirm: "Are you sure? This will remove the order and revert all associated inventory levels." } },
                class: "text-red-600 hover:text-red-700 font-semibold underline transition bg-transparent border-none p-0 cursor-pointer" %>
            </td>
          </tr>
        <% end %>
        <% if @sales_orders.empty? %>
          <tr>
            <td colspan="5" class="px-6 py-10 text-center text-gray-400">No outbound orders processed yet.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
