<%
  is_hash = item.is_a?(Hash) || item.is_a?(ActionController::Parameters)
  p_id = is_hash ? item["product_id"] : (item&.product_batch&.product_id)
  b_id = is_hash ? item["product_batch_id"] : item&.product_batch_id
  qty  = is_hash ? item["quantity"] : item&.quantity
  u_p  = is_hash ? item["unit_price"] : item&.unit_price
%>

<div class="item-row flex items-center justify-between gap-4 bg-gray-50 p-4 rounded-xl border border-gray-200 shadow-sm relative group transition-all hover:border-gray-300 mb-3">
  <div class="flex-1 flex flex-col space-y-3 mb-5">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="w-full">
        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Product</label>
        <select name="items[<%= idx %>][product_id]" required class="product-select block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-2 focus:ring-green-600 focus:border-green-600 py-2">
          <option value="">-- Choose Product --</option>
          <% @products.each do |p| %>
            <option value="<%= p.id %>" <%= "selected" if p_id.to_s == p.id.to_s %>><%= p.name %></option>
          <% end %>
        </select>
      </div>

      <div class="w-full">
        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Batch</label>
        <select name="items[<%= idx %>][product_batch_id]" class="batch-select block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-2 focus:ring-green-600 focus:border-green-600 py-2" data-selected-id="<%= b_id %>">
          <option value="">Automated FIFO</option>
        </select>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="w-full">
        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Qty</label>
        <input type="number" name="items[<%= idx %>][quantity]" value="<%= qty %>" min="1" required class="block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-2 focus:ring-green-600 focus:border-green-600 p-2 text-center">
      </div>

      <div class="w-full">
        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Price</label>
        <input type="number" step="0.01" name="items[<%= idx %>][unit_price]" value="<%= u_p %>" min="0" required class="block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-2 focus:ring-green-600 focus:border-green-600 p-2">
      </div>
    </div>

  </div>

  <div class="flex-shrink-0 self-center pt-5">
    <button type="button" class="remove-item-btn p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-red-500" title="Remove item">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
      </svg>
    </button>
  </div>
</div>
