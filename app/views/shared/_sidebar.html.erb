<!-- app/views/layouts/_sidebar.html.erb (or your sidebar file) -->
<aside data-controller="sidebar-toggle"
        data-sidebar-toggle-target="container"
        class="hidden md:flex flex-col w-full md:w-64 bg-gray-900 text-gray-300 h-full max-h-full p-4 space-y-6 transition-all duration-300 ease-in-out relative shadow-xl flex-shrink-0 overflow-hidden">

  <button data-action="click->sidebar-toggle#toggle"
          class="hidden md:flex absolute top-5 -right-3 bg-green-500 text-white rounded-full p-1.5 border-2 border-gray-900 hover:bg-green-600 focus:outline-none transition-transform active:scale-95 z-50 shadow-md"
          title="Toggle Sidebar Layout">
    <svg data-sidebar-toggle-target="icon" class="w-4 h-4 transition-transform duration-300 transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
    </svg>
  </button>

  <div class="px-2 py-4 border-b border-gray-800 w-full overflow-hidden whitespace-nowrap flex items-center space-x-3 flex-shrink-0">
    <div class="bg-green-500 p-2 rounded-lg text-gray-900 flex-shrink-0">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M16.243 17.657l.707.707M7.757 6.364l.707-.707M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>

    <div data-sidebar-toggle-target="textOnly" class="transition-opacity duration-200">
      <h1 class="text-xl font-black text-white tracking-widest uppercase leading-none">Grain CRM</h1>
      <div class="text-[10px] font-semibold uppercase tracking-wider mt-0.5 <%= request.path.start_with?('/admin') ? 'text-green-400' : 'text-blue-400' %>">
        <%= request.path.start_with?('/admin') ? 'Admin Portal' : 'User Space' %>
      </div>
    </div>
  </div>

  <nav class="flex-1 space-y-2 w-full overflow-y-auto min-h-0 pr-1 custom-scrollbar">
    <% if current_user.super_admin? %>

      <%= link_to admin_root_path, title: "Manage Organizations",
                  class: "flex items-center space-x-3 px-3 py-3 rounded-lg font-medium transition-all hover:bg-gray-800 hover:text-white #{'bg-gray-800 text-white' if current_page?(admin_root_path)}" do %>
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2V6z"/></svg>
        <span data-sidebar-toggle-target="textOnly" class="whitespace-nowrap">Admin Dashboard</span>
      <% end %>

      <%= link_to admin_root_path, title: "Manage Organizations",
                  class: "flex items-center space-x-3 px-3 py-3 rounded-lg font-medium transition-all hover:bg-gray-800 hover:text-white #{'bg-gray-800 text-white' if current_page?(admin_organizations_path)}" do %>
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5"/></svg>
        <span data-sidebar-toggle-target="textOnly" class="whitespace-nowrap">Manage Orgs</span>
      <% end %>

    <% else %>

      <%= link_to dashboard_path, title: "My Dashboard",
                  class: "flex items-center space-x-3 px-3 py-3 rounded-lg font-medium transition-all hover:bg-gray-800 hover:text-white #{'bg-gray-800 text-white' if current_page?(dashboard_path)}" do %>
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3"/></svg>
        <span data-sidebar-toggle-target="textOnly" class="whitespace-nowrap">My Dashboard</span>
      <% end %>

      <!-- NEW: Suppliers Navigation Link -->
      <%= link_to suppliers_path, title: "Suppliers Directory",
                  class: "flex items-center space-x-3 px-3 py-3 rounded-lg font-medium transition-all hover:bg-gray-800 hover:text-white #{'bg-gray-800 text-white' if current_page?(suppliers_path) || request.path.start_with?('/suppliers')}" do %>
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        <span data-sidebar-toggle-target="textOnly" class="whitespace-nowrap">Suppliers Directory</span>
      <% end %>

      <%= link_to products_path, title: "Product Catalog",
              class: "flex items-center space-x-3 px-3 py-3 rounded-lg font-medium transition-all hover:bg-gray-800 hover:text-white #{'bg-gray-800 text-white' if current_page?(products_path) || request.path.start_with?('/products') && !request.path.include?('/product_batches')}" do %>
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        <span data-sidebar-toggle-target="textOnly" class="whitespace-nowrap">Product Catalog</span>
      <% end %>

      <!-- NEW: Sales Orders & Fulfillment Link -->
      <%= link_to sales_orders_path, title: "Sales Orders",
                  class: "flex items-center space-x-3 px-3 py-3 rounded-lg font-medium transition-all hover:bg-gray-800 hover:text-white #{'bg-gray-800 text-white' if current_page?(sales_orders_path) || request.path.start_with?('/sales_orders')}" do %>
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span data-sidebar-toggle-target="textOnly" class="whitespace-nowrap">Sales Orders</span>
      <% end %>

      <!-- NEW: Inventory Operations & Audits Link -->
      <%= link_to inventory_adjustments_path, title: "Inventory Audits & Alerts",
                  class: "flex items-center space-x-3 px-3 py-3 rounded-lg font-medium transition-all hover:bg-gray-800 hover:text-white #{'bg-gray-800 text-white' if current_page?(inventory_adjustments_path) || request.path.start_with?('/inventory_adjustments') || request.path.start_with?('/inventory_alerts')}" do %>
        <div class="relative flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
          </svg>
          <% if current_user.organization.inventory_alerts.unread.exists? %>
            <span class="absolute -top-1 -right-1 flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
            </span>
          <% end %>
        </div>
        <span data-sidebar-toggle-target="textOnly" class="whitespace-nowrap">Inventory Operations</span>
      <% end %>

      <!-- Expiration Monitor -->
      <%= link_to expirations_path, title: "Expiration Monitor",
                  class: "flex items-center space-x-3 px-3 py-3 rounded-lg font-medium transition-all hover:bg-gray-800 hover:text-white #{'bg-gray-800 text-white' if request.path.start_with?('/expirations')}" do %>
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span data-sidebar-toggle-target="textOnly" class="whitespace-nowrap">
          Expiration Monitor
          <% expired_count = current_user.organization.product_batches.where("expiry_date < ? AND quantity_on_hand > 0", Date.current).count %>
          <% critical_count = current_user.organization.product_batches.where(expiry_date: Date.current..7.days.from_now.to_date).where("quantity_on_hand > 0").count %>
          <% total_urgent = expired_count + critical_count %>
          <% if total_urgent > 0 %>
            <span class="ml-1 inline-flex items-center justify-center px-1.5 py-0.5 text-xs font-bold rounded-full bg-red-500 text-white"><%= total_urgent %></span>
          <% end %>
        </span>
      <% end %>

      <%= link_to profits_path, title: "Profit Analytics",
            class: "flex items-center space-x-3 px-3 py-3 rounded-lg font-medium transition-all hover:bg-gray-800 hover:text-white #{'bg-gray-800 text-white' if current_page?(profits_path) || request.path.start_with?('/profits')}" do %>
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span data-sidebar-toggle-target="textOnly" class="whitespace-nowrap">Profit Analytics</span>
      <% end %>

      <!-- NEW: Farmers Khata Link -->
      <%= link_to farmers_path, title: "Farmers Khata",
                  class: "flex items-center space-x-3 px-3 py-3 rounded-lg font-medium transition-all hover:bg-gray-800 hover:text-white #{'bg-gray-800 text-white' if current_page?(farmers_path) || request.path.start_with?('/farmers')}" do %>
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        <span data-sidebar-toggle-target="textOnly" class="whitespace-nowrap">Farmers Khata</span>
      <% end %>

      <!-- NEW: Trading Partners Link -->
      <%= link_to trading_partners_path, title: "Trading Partners",
                  class: "flex items-center space-x-3 px-3 py-3 rounded-lg font-medium transition-all hover:bg-gray-800 hover:text-white #{'bg-gray-800 text-white' if current_page?(trading_partners_path) || request.path.start_with?('/trading_partners')}" do %>
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4M16 17H4m0 0l4 4m-4-4l4-4"/></svg>
        <span data-sidebar-toggle-target="textOnly" class="whitespace-nowrap">Trading Partners</span>
      <% end %>

      <!-- NEW: Crop Stock Link -->
      <%= link_to crops_path, title: "Crop Stock",
                  class: "flex items-center space-x-3 px-3 py-3 rounded-lg font-medium transition-all hover:bg-gray-800 hover:text-white #{'bg-gray-800 text-white' if current_page?(crops_path) || request.path.start_with?('/crops')}" do %>
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
        <span data-sidebar-toggle-target="textOnly" class="whitespace-nowrap">Crop Stock</span>
      <% end %>

    <% end %>
  </nav>

  <div class="pt-4 border-t border-gray-800 flex items-center justify-between w-full overflow-hidden flex-shrink-0">
    <div data-sidebar-toggle-target="textOnly" class="whitespace-nowrap">
      <p class="text-white font-semibold text-xs">Active Profile</p>
    </div>
    <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, title: "Sign Out", class: "text-red-400 hover:text-red-500" do %>
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
    <% end %>
  </div>
</aside>
