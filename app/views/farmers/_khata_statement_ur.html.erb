<link href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400;700&display=swap" rel="stylesheet">

<div style="font-family: 'Noto Nastaliq Urdu', serif; direction: rtl; text-align: right;">

  <!-- Header -->
  <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid #d1d5db; padding-bottom: 1rem; margin-bottom: 1.5rem;">
    <div>
      <h1 style="font-size: 26px; font-weight: 700; color: #111827; margin: 0 0 4px;">کھاتہ بیان</h1>
      <p style="font-size: 13px; color: #6b7280; margin: 0;">تاریخ: <%= Date.current.strftime("%d %b %Y") %></p>
    </div>
    <div style="text-align: left;">
      <p class="text-xs text-gray-500">
        <% if current_user.organization.urdu_name.present? %>
          <span style="font-family: 'Noto Nastaliq Urdu', serif; direction: rtl; display: block;">
            <%= current_user.organization.urdu_name %>
          </span>
        <% end %>
        <%= current_user.organization.name %>
      </p>
    </div>
  </div>

  <!-- Farmer Info -->
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
    <div style="background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 1rem;">
      <p style="font-size: 11px; color: #9ca3af; margin: 0 0 6px; text-transform: uppercase; letter-spacing: 0.05em;">کسان کی تفصیل</p>
      <p style="font-size: 20px; font-weight: 700; color: #111827; margin: 0;"><%= @farmer.urdu_name %></p>
      <p style="font-size: 13px; color: #6b7280; margin: 4px 0 0;"><%= @farmer.full_name %></p>
      <p style="font-size: 13px; color: #6b7280; margin: 2px 0 0;"><%= @farmer.primary_phone %></p>
      <% if @farmer.secondary_phone.present? %>
        <p style="font-size: 13px; color: #6b7280; margin: 2px 0 0;"><%= @farmer.secondary_phone %></p>
      <% end %>
      <p style="font-size: 13px; color: #6b7280; margin: 4px 0 0;"><%= @farmer.address %></p>
    </div>

    <div style="background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 1rem;">
      <p style="font-size: 11px; color: #9ca3af; margin: 0 0 6px; text-transform: uppercase; letter-spacing: 0.05em;">موجودہ حساب</p>
      <p style="font-size: 26px; font-weight: 700; margin: 0; color: <%= @farmer.current_balance.negative? ? '#dc2626' : '#15803d' %>;">
        Rs. <%= number_with_delimiter(@farmer.current_balance.abs.round(2)) %>
      </p>
      <p style="font-size: 13px; color: #6b7280; margin: 4px 0 0;">
        <%= @farmer.current_balance.negative? ? "کسان ہمارے مقروض ہیں" : "ہم کسان کے مقروض ہیں" %>
      </p>
      <p style="font-size: 13px; color: #374151; margin: 8px 0 0;">
        بردانہ: <strong><%= @farmer.bardaana_balance %> بوری</strong>
      </p>
    </div>
  </div>

  <!-- Active Cycle -->
  <div style="margin-bottom: 2rem;">
    <h2 style="font-size: 16px; font-weight: 700; color: #111827; border-bottom: 1px solid #e5e7eb; padding-bottom: 6px; margin-bottom: 1rem;">
      فعال کھاتہ
    </h2>

    <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
      <thead>
        <tr style="background: #f3f4f6;">
          <th style="padding: 8px 10px; border: 1px solid #e5e7eb; color: #6b7280; font-weight: 500;">تاریخ</th>
          <th style="padding: 8px 10px; border: 1px solid #e5e7eb; color: #6b7280; font-weight: 500;">تفصیل</th>
          <th style="padding: 8px 10px; border: 1px solid #e5e7eb; color: #6b7280; font-weight: 500; text-align: left;">جمع</th>
          <th style="padding: 6px 10px; border: 1px solid #e5e7eb; color: #6b7280; font-weight: 500; text-align: left;">نام</th>
          <th style="padding: 8px 10px; border: 1px solid #e5e7eb; color: #6b7280; font-weight: 500; text-align: left;">بقایا</th>
          <th style="padding: 8px 10px; border: 1px solid #e5e7eb; color: #6b7280; font-weight: 500; text-align: left;">بوری</th>
        </tr>
      </thead>
      <tbody>
        <% if @active_transactions.any? %>
          <% @active_transactions.each do |txn| %>
            <tr>
              <td style="padding: 8px 10px; border: 1px solid #e5e7eb; color: #6b7280; white-space: nowrap;"><%= txn.created_at.strftime("%d %b %Y") %></td>
              <td style="padding: 8px 10px; border: 1px solid #e5e7eb; color: #374151;"><%= txn.sourceable.is_a?(SalesOrder) ? txn.sourceable.line_items_summary : txn.description %></td>
              <td style="padding: 8px 10px; border: 1px solid #e5e7eb; color: #15803d; text-align: left;"><%= "Rs. #{number_with_delimiter(txn.amount.round(2))}" if txn.credit? %></td>
              <td style="padding: 8px 10px; border: 1px solid #e5e7eb; color: #dc2626; text-align: left;"><%= "Rs. #{number_with_delimiter(txn.amount.round(2))}" if txn.debit? %></td>
              <td style="padding: 8px 10px; border: 1px solid #e5e7eb; font-weight: 600; color: #111827; text-align: left;">Rs. <%= number_with_delimiter(txn.resulting_balance.round(2)) %></td>
              <td style="padding: 8px 10px; border: 1px solid #e5e7eb; text-align: left;">
                <% if txn.bardaana_credit > 0 %>
                  <span style="color: #1d4ed8;">+<%= txn.bardaana_credit %></span>
                <% elsif txn.bardaana_debit > 0 %>
                  <span style="color: #ea580c;">-<%= txn.bardaana_debit %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" style="padding: 1rem; text-align: center; color: #9ca3af;">اس کھاتے میں ابھی کوئی لین دین نہیں ہے</td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr style="background: #f9fafb;">
          <td colspan="4" style="padding: 8px 10px; border: 1px solid #e5e7eb; font-weight: 700; color: #374151;">اختتامی بقایا</td>
          <td style="padding: 8px 10px; border: 1px solid #e5e7eb; font-weight: 700; text-align: left; color: <%= @farmer.current_balance.negative? ? '#dc2626' : '#15803d' %>;">
            Rs. <%= number_with_delimiter(@farmer.current_balance.abs.round(2)) %>
          </td>
          <td style="padding: 8px 10px; border: 1px solid #e5e7eb; font-weight: 600; text-align: left; color: #374151;"><%= @farmer.bardaana_balance %> بوری</td>
        </tr>
      </tfoot>
    </table>
  </div>

  <!-- Closed Cycles -->
  <% if @closed_cycles.any? %>
    <div style="margin-bottom: 2rem;">
      <h2 style="font-size: 16px; font-weight: 700; color: #111827; border-bottom: 1px solid #e5e7eb; padding-bottom: 6px; margin-bottom: 1rem;">
        پرانے کھاتے
      </h2>

      <% @closed_cycles.each do |entry| %>
        <div style="margin-bottom: 1.5rem;">
          <p style="font-size: 12px; color: #6b7280; margin: 0 0 6px;">
            بند تاریخ: <%= entry[:cycle].closed_at.strftime("%d %b %Y") %> —
            اختتامی بقایا:
            <strong style="color: <%= entry[:cycle].closing_balance.negative? ? '#dc2626' : '#15803d' %>;">
              Rs. <%= number_with_delimiter(entry[:cycle].closing_balance.abs.round(2)) %>
            </strong>
          </p>

          <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
            <thead>
              <tr style="background: #f3f4f6;">
                <th style="padding: 6px 10px; border: 1px solid #e5e7eb; color: #6b7280; font-weight: 500;">تاریخ</th>
                <th style="padding: 6px 10px; border: 1px solid #e5e7eb; color: #6b7280; font-weight: 500;">تفصیل</th>
                <th style="padding: 6px 10px; border: 1px solid #e5e7eb; color: #6b7280; font-weight: 500; text-align: left;">جمع</th>
                <th style="padding: 6px 10px; border: 1px solid #e5e7eb; color: #6b7280; font-weight: 500; text-align: left;">خرچ</th>
                <th style="padding: 6px 10px; border: 1px solid #e5e7eb; color: #6b7280; font-weight: 500; text-align: left;">بقایا</th>
              </tr>
            </thead>
            <tbody>
              <% entry[:transactions].each do |txn| %>
                <tr>
                  <td style="padding: 6px 10px; border: 1px solid #e5e7eb; color: #6b7280;"><%= txn.created_at.strftime("%d %b %Y") %></td>
                  <td style="padding: 6px 10px; border: 1px solid #e5e7eb; color: #374151;"><%= txn.sourceable.is_a?(SalesOrder) ? txn.sourceable.line_items_summary : txn.description %></td>
                  <td style="padding: 6px 10px; border: 1px solid #e5e7eb; color: #15803d; text-align: left;"><%= "Rs. #{number_with_delimiter(txn.amount.round(2))}" if txn.credit? %></td>
                  <td style="padding: 6px 10px; border: 1px solid #e5e7eb; color: #dc2626; text-align: left;"><%= "Rs. #{number_with_delimiter(txn.amount.round(2))}" if txn.debit? %></td>
                  <td style="padding: 6px 10px; border: 1px solid #e5e7eb; font-weight: 600; color: #111827; text-align: left;">Rs. <%= number_with_delimiter(txn.resulting_balance.round(2)) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Product Sales -->
  <% if @sales_orders.any? %>
    <div style="margin-bottom: 2rem;">
      <h2 style="font-size: 16px; font-weight: 700; color: #111827; border-bottom: 1px solid #e5e7eb; padding-bottom: 6px; margin-bottom: 1rem;">
        ادھار فروخت (مال)
      </h2>

      <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
        <thead>
          <tr style="background: #f3f4f6;">
            <th style="padding: 8px 10px; border: 1px solid #e5e7eb; color: #6b7280; font-weight: 500;">آرڈر نمبر</th>
            <th style="padding: 8px 10px; border: 1px solid #e5e7eb; color: #6b7280; font-weight: 500;">تاریخ</th>
            <th style="padding: 8px 10px; border: 1px solid #e5e7eb; color: #6b7280; font-weight: 500; text-align: left;">رقم</th>
          </tr>
        </thead>
        <tbody>
          <% @sales_orders.each do |order| %>
            <tr>
              <td style="padding: 8px 10px; border: 1px solid #e5e7eb; color: #374151; font-family: monospace;"><%= order.order_number %></td>
              <td style="padding: 8px 10px; border: 1px solid #e5e7eb; color: #6b7280;"><%= order.placed_at.strftime("%d %b %Y") %></td>
              <td style="padding: 8px 10px; border: 1px solid #e5e7eb; color: #dc2626; font-weight: 600; text-align: left;">Rs. <%= number_with_delimiter(order.total_revenue.round(2)) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr style="background: #f9fafb;">
            <td colspan="2" style="padding: 8px 10px; border: 1px solid #e5e7eb; font-weight: 700; color: #374151;">کل فروخت</td>
            <td style="padding: 8px 10px; border: 1px solid #e5e7eb; font-weight: 700; color: #dc2626; text-align: left;">
              Rs. <%= number_with_delimiter(@sales_orders.sum(&:total_revenue).round(2)) %>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% end %>

  <!-- Footer -->
  <div style="border-top: 1px solid #e5e7eb; padding-top: 1rem; margin-top: 2rem; display: flex; justify-content: space-between; font-size: 11px; color: #9ca3af;">
    <span>
      یہ بیان تیار کیا —
      <% if current_user.organization.urdu_name.present? %>
        <span style="font-family: 'Noto Nastaliq Urdu', serif;">
          <%= current_user.organization.urdu_name %>
        </span>
      <% else %>
        <%= current_user.organization.name %>
      <% end %>
    </span>
    <span>پرنٹ تاریخ: <%= Time.current.strftime("%d %b %Y, %I:%M %p") %></span>
  </div>

</div>
