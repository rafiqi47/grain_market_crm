<div class="max-w-5xl mx-auto py-8">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900">Crop Purchase History</h1>
      <p class="text-gray-500 text-sm mt-1">
        <%= link_to @farmer.full_name, farmer_path(@farmer), class: "text-green-600 hover:underline" %>
      </p>
    </div>
    <%= link_to "Record New Purchase", new_farmer_crop_purchase_path(@farmer), class: "bg-green-600 hover:bg-green-700 text-white font-medium rounded-md py-2 px-4 text-sm" %>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Crop</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Gross Weight</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Katt</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Net Weight</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Rate/Maund</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Gross Value</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Commission</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Labor</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Net Value</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Bags</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @crop_purchases.each do |purchase| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap"><%= purchase.purchase_date.strftime("%d %b %Y") %></td>
            <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= purchase.crop.name %></td>
            <td class="px-4 py-3 text-sm text-right text-gray-700"><%= purchase.gross_weight_formatted %></td>
            <td class="px-4 py-3 text-sm text-right text-gray-500"><%= purchase.katt_deduction_formatted %></td>
            <td class="px-4 py-3 text-sm text-right font-medium text-gray-900"><%= purchase.net_weight_formatted %></td>
            <td class="px-4 py-3 text-sm text-right text-gray-700">Rs. <%= number_with_delimiter(purchase.market_rate.round(2)) %></td>
            <td class="px-4 py-3 text-sm text-right text-gray-700">Rs. <%= number_with_delimiter(purchase.gross_value.round(2)) %></td>
            <td class="px-4 py-3 text-sm text-right text-gray-500">
              <% if purchase.commission_amount > 0 %>
                Rs. <%= number_with_delimiter(purchase.commission_amount.round(2)) %>
              <% else %>
                <span class="text-gray-300">—</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-sm text-right text-gray-500">
              <% if purchase.labor_cost > 0 %>
                Rs. <%= number_with_delimiter(purchase.labor_cost.round(2)) %>
              <% else %>
                <span class="text-gray-300">—</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-sm text-right font-semibold text-green-700">Rs. <%= number_with_delimiter(purchase.net_ledger_value.round(2)) %></td>
            <td class="px-4 py-3 text-sm text-right text-gray-600">
              <% if purchase.bardaana_bags_count > 0 %>
                <%= purchase.bardaana_bags_count %>
                <span class="text-xs text-gray-400">(<%= purchase.bardaana_owner.humanize %>)</span>
              <% else %>
                <span class="text-gray-300">—</span>
              <% end %>
            </td>
          </tr>
        <% end %>

        <% if @crop_purchases.empty? %>
          <tr>
            <td colspan="11" class="px-4 py-8 text-center text-gray-400 text-sm">No crop purchases recorded yet.</td>
          </tr>
        <% end %>
      </tbody>

      <% if @crop_purchases.any? %>
        <tfoot class="bg-gray-50 border-t border-gray-200">
          <tr>
            <td colspan="6" class="px-4 py-3 text-sm font-semibold text-gray-700">Totals</td>
            <td class="px-4 py-3 text-sm text-right font-semibold text-gray-900">
              Rs. <%= number_with_delimiter(@crop_purchases.sum(&:gross_value).round(2)) %>
            </td>
            <td class="px-4 py-3 text-sm text-right font-semibold text-gray-700">
              Rs. <%= number_with_delimiter(@crop_purchases.sum(&:commission_amount).round(2)) %>
            </td>
            <td class="px-4 py-3 text-sm text-right font-semibold text-gray-700">
              Rs. <%= number_with_delimiter(@crop_purchases.sum(&:labor_cost).round(2)) %>
            </td>
            <td class="px-4 py-3 text-sm text-right font-bold text-green-700">
              Rs. <%= number_with_delimiter(@crop_purchases.sum(&:net_ledger_value).round(2)) %>
            </td>
            <td class="px-4 py-3 text-sm text-right font-semibold text-gray-700">
              <%= @crop_purchases.sum(&:bardaana_bags_count) %> bags
            </td>
          </tr>
        </tfoot>
      <% end %>
    </table>
  </div>
</div>
