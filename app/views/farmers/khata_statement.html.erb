<% content_for :title, "Khata Statement — #{@farmer.full_name}" %>

<%# Language toggle — sits in the print bar (no-print) %>
<script>
  function switchLanguage(lang) {
    document.getElementById("statement-en").style.display = lang === "en" ? "block" : "none"
    document.getElementById("statement-ur").style.display = lang === "ur" ? "block" : "none"
    document.getElementById("btn-en").style.fontWeight = lang === "en" ? "700" : "400"
    document.getElementById("btn-ur").style.fontWeight = lang === "ur" ? "700" : "400"
  }
</script>

<div class="no-print flex items-center gap-3 mb-6 p-3 bg-gray-100 border border-gray-300 rounded-md">
  <span class="text-sm text-gray-600">Statement language:</span>
  <button id="btn-en" onclick="switchLanguage('en')" style="font-weight: 700;"
    class="text-sm px-3 py-1 rounded border border-gray-300 bg-white hover:bg-gray-50">
    English
  </button>
  <button id="btn-ur" onclick="switchLanguage('ur')" style="font-weight: 400;"
    class="text-sm px-3 py-1 rounded border border-gray-300 bg-white hover:bg-gray-50"
    style="font-family: 'Noto Nastaliq Urdu', serif;">
    اردو
  </button>
</div>

<!-- English Statement -->
<div id="statement-en">
  <%= render "farmers/khata_statement_en" %>
</div>

<!-- Urdu Statement -->
<div id="statement-ur" style="display: none;">
  <%= render "farmers/khata_statement_ur" %>
</div>
