<div class="max-w-5xl mx-auto py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold text-gray-900">Farmers Khata</h1>
    <%= link_to "Add Farmer", new_farmer_path, class: "bg-green-600 hover:bg-green-700 text-white font-medium rounded-md py-2 px-4" %>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Phone</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Balance</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Bardaana</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @farmers.each do |farmer| %>
          <tr class="hover:bg-gray-50 cursor-pointer" onclick="window.location='<%= farmer_path(farmer) %>'">
            <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= farmer.full_name %></td>
            <td class="px-4 py-3 text-sm text-gray-500"><%= farmer.primary_phone %></td>
            <td class="px-4 py-3 text-sm text-right font-medium <%= farmer.current_balance.negative? ? 'text-red-600' : 'text-green-700' %>">
              Rs. <%= number_with_delimiter(farmer.current_balance.abs.round(2)) %>
              <span class="text-xs text-gray-400"><%= farmer.current_balance.negative? ? "(owes us)" : "(we owe)" %></span>
            </td>
            <td class="px-4 py-3 text-sm text-right text-gray-600"><%= farmer.bardaana_balance %> bags</td>
          </tr>
        <% end %>

        <% if @farmers.empty? %>
          <tr><td colspan="4" class="px-4 py-8 text-center text-gray-400 text-sm">No farmers added yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
