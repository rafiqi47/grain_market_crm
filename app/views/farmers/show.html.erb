<div class="max-w-3xl mx-auto py-8">
  <div class="flex items-start justify-between mb-6">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900"><%= @farmer.full_name %></h1>
      <p class="text-gray-500 text-sm mt-1"><%= @farmer.primary_phone %><%= " · #{@farmer.secondary_phone}" if @farmer.secondary_phone.present? %></p>
      <p class="text-gray-500 text-sm"><%= @farmer.address %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_farmer_path(@farmer), class: "bg-white border border-gray-300 text-gray-700 font-medium rounded-md py-2 px-4 text-sm" %>
      <%= link_to "Record Crop Purchase", new_farmer_crop_purchase_path(@farmer), class: "bg-green-600 hover:bg-green-700 text-white font-medium rounded-md py-2 px-4 text-sm" %>
    </div>
  </div>

  <!-- Active Khata Summary -->
  <div class="grid grid-cols-2 gap-4 mb-6">
    <div class="bg-white border border-gray-200 rounded-lg p-5">
      <p class="text-xs text-gray-500 uppercase font-medium">Current Balance</p>
      <p class="text-2xl font-semibold mt-1 <%= @farmer.current_balance.negative? ? 'text-red-600' : 'text-green-700' %>">
        Rs. <%= number_with_delimiter(@farmer.current_balance.abs.round(2)) %>
      </p>
      <p class="text-xs text-gray-400 mt-1"><%= @farmer.current_balance.negative? ? "Farmer owes us" : "We owe farmer" %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg p-5">
      <p class="text-xs text-gray-500 uppercase font-medium">Bardaana Balance</p>
      <p class="text-2xl font-semibold mt-1 text-gray-900"><%= @farmer.bardaana_balance %> bags</p>
      <p class="text-xs text-gray-400 mt-1"><%= @farmer.bardaana_balance.positive? ? "Farmer owes us bags" : @farmer.bardaana_balance.negative? ? "We owe farmer bags" : "Settled" %></p>
    </div>
  </div>

  <!-- Active Cycle Ledger -->
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6">
    <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
      <h2 class="font-medium text-gray-900">Active Khata Cycle</h2>
      <div class="flex gap-2">
        <%= link_to "+ Add Entry",
              new_farmer_khata_cycle_khata_transaction_path(@farmer, @active_cycle),
              class: "text-sm bg-green-600 hover:bg-green-700 text-white rounded-md py-1.5 px-3" %>
        <% if current_user.owner? || current_user.super_admin? %>
          <%= button_to "Close & Settle Cycle", close_farmer_khata_cycle_path(@farmer, @active_cycle),
                method: :post,
                data: { turbo_confirm: "Close this cycle? If a balance remains, it will roll forward into a new cycle." },
                class: "text-sm bg-gray-800 hover:bg-gray-900 text-white rounded-md py-1.5 px-3" %>
        <% end %>
      </div>
    </div>

    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
          <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Credit</th>
          <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Debit</th>
          <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Balance</th>
          <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Bags</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @transactions.each do |txn| %>
          <tr>
            <td class="px-4 py-2 text-sm text-gray-500"><%= txn.created_at.strftime("%d %b %Y") %></td>
            <td class="px-4 py-2 text-sm text-gray-700"><%= txn.description %></td>
            <td class="px-4 py-2 text-sm text-right text-green-700"><%= "Rs. #{number_with_delimiter(txn.amount.round(2))}" if txn.credit? %></td>
            <td class="px-4 py-2 text-sm text-right text-red-600"><%= "Rs. #{number_with_delimiter(txn.amount.round(2))}" if txn.debit? %></td>
            <td class="px-4 py-2 text-sm text-right font-medium text-gray-900">Rs. <%= number_with_delimiter(txn.resulting_balance.round(2)) %></td>
            <td class="px-4 py-2 text-sm text-right text-gray-600">
              <% if txn.bardaana_credit > 0 %>
                <span class="text-blue-600">+<%= txn.bardaana_credit %></span>
              <% elsif txn.bardaana_debit > 0 %>
                <span class="text-orange-600">-<%= txn.bardaana_debit %></span>
              <% end %>
            </td>
            <td class="px-4 py-2 text-right">
              <%= link_to "Edit", edit_farmer_khata_cycle_khata_transaction_path(@farmer, @active_cycle, txn), class: "text-xs text-gray-400 hover:text-gray-700" %>
            </td>
          </tr>
        <% end %>

        <% if @transactions.empty? %>
          <tr><td colspan="5" class="px-4 py-6 text-center text-gray-400 text-sm">No transactions in this cycle yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Historical Archive -->
  <% if @closed_cycles.any? %>
    <details class="bg-white border border-gray-200 rounded-lg p-4">
      <summary class="cursor-pointer font-medium text-gray-700 text-sm">Historical Cycles (<%= @closed_cycles.count %>)</summary>
      <div class="mt-3 divide-y divide-gray-100">
        <% @closed_cycles.each do |cycle| %>
          <%= link_to farmer_khata_cycle_path(@farmer, cycle), class: "flex items-center justify-between py-2 text-sm hover:bg-gray-50 px-2 rounded" do %>
            <span class="text-gray-600">Closed <%= cycle.closed_at.strftime("%d %b %Y") %></span>
            <span class="font-medium <%= cycle.closing_balance.negative? ? 'text-red-600' : 'text-green-700' %>">
              Rs. <%= number_with_delimiter(cycle.closing_balance.abs.round(2)) %>
            </span>
          <% end %>
        <% end %>
      </div>
    </details>
  <% end %>
</div>
