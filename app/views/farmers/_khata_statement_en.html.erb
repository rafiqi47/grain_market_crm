<% content_for :title, "Khata Statement — #{@farmer.full_name}" %>

<!-- Header -->
<div class="flex items-start justify-between border-b border-gray-300 pb-4 mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Khata Statement</h1>
    <p class="text-sm text-gray-500 mt-1">Generated on <%= Date.current.strftime("%d %b %Y") %></p>
  </div>
  <div class="text-right">
    <p class="text-lg font-bold text-gray-900">Grain CRM</p>
    <p class="text-xs text-gray-500"><%= current_user.organization.name %></p>
  </div>
</div>

<!-- Farmer Info -->
<div class="grid grid-cols-2 gap-6 mb-6">
  <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
    <p class="text-xs font-semibold text-gray-500 uppercase mb-2">Farmer Details</p>
    <p class="font-bold text-gray-900 text-lg"><%= @farmer.full_name %></p>
    <p class="text-sm text-gray-600"><%= @farmer.primary_phone %></p>
    <% if @farmer.secondary_phone.present? %>
      <p class="text-sm text-gray-600"><%= @farmer.secondary_phone %></p>
    <% end %>
    <p class="text-sm text-gray-600 mt-1"><%= @farmer.address %></p>
  </div>

  <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
    <p class="text-xs font-semibold text-gray-500 uppercase mb-2">Current Position</p>
    <p class="text-2xl font-bold <%= @farmer.current_balance.negative? ? 'text-red-600' : 'text-green-700' %>">
      Rs. <%= number_with_delimiter(@farmer.current_balance.abs.round(2)) %>
    </p>
    <p class="text-sm text-gray-500"><%= @farmer.current_balance.negative? ? "Farmer owes us" : "We owe farmer" %></p>
    <p class="text-sm text-gray-600 mt-2">Bardaana: <span class="font-medium"><%= @farmer.bardaana_balance %> bags</span></p>
  </div>
</div>

<!-- Active Cycle -->
<div class="mb-8">
  <h2 class="text-base font-bold text-gray-900 mb-2 border-b border-gray-200 pb-1">
    Active Khata Cycle
  </h2>

  <table class="min-w-full text-sm border border-gray-200 rounded-lg overflow-hidden">
    <thead class="bg-gray-100">
      <tr>
        <th class="px-3 py-2 text-left text-xs font-semibold text-gray-600 uppercase">Date</th>
        <th class="px-3 py-2 text-left text-xs font-semibold text-gray-600 uppercase">Description</th>
        <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600 uppercase">Credit</th>
        <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600 uppercase">Debit</th>
        <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600 uppercase">Balance</th>
        <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600 uppercase">Bags</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% if @active_transactions.any? %>
        <% @active_transactions.each do |txn| %>
          <tr>
            <td class="px-3 py-2 text-gray-500"><%= txn.created_at.strftime("%d %b %Y") %></td>
            <td class="px-3 py-2 text-gray-700"><%= txn.sourceable.is_a?(SalesOrder) ? txn.sourceable.line_items_summary : txn.description %></td>
            <td class="px-3 py-2 text-right text-green-700"><%= "Rs. #{number_with_delimiter(txn.amount.round(2))}" if txn.credit? %></td>
            <td class="px-3 py-2 text-right text-red-600"><%= "Rs. #{number_with_delimiter(txn.amount.round(2))}" if txn.debit? %></td>
            <td class="px-3 py-2 text-right font-medium text-gray-900">Rs. <%= number_with_delimiter(txn.resulting_balance.round(2)) %></td>
            <td class="px-3 py-2 text-right text-gray-600">
              <% if txn.bardaana_credit > 0 %>
                <span class="text-blue-600">+<%= txn.bardaana_credit %></span>
              <% elsif txn.bardaana_debit > 0 %>
                <span class="text-orange-600">-<%= txn.bardaana_debit %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="6" class="px-3 py-4 text-center text-gray-400">No transactions in active cycle.</td>
        </tr>
      <% end %>
    </tbody>
    <tfoot class="bg-gray-50 border-t border-gray-200">
      <tr>
        <td colspan="4" class="px-3 py-2 text-sm font-semibold text-gray-700">Active Cycle Closing Balance</td>
        <td class="px-3 py-2 text-right font-bold <%= @farmer.current_balance.negative? ? 'text-red-600' : 'text-green-700' %>">
          Rs. <%= number_with_delimiter(@farmer.current_balance.abs.round(2)) %>
        </td>
        <td class="px-3 py-2 text-right font-medium text-gray-700"><%= @farmer.bardaana_balance %> bags</td>
      </tr>
    </tfoot>
  </table>
</div>

<!-- Closed Cycles -->
<% if @closed_cycles.any? %>
  <div class="mb-8">
    <h2 class="text-base font-bold text-gray-900 mb-2 border-b border-gray-200 pb-1">
      Historical Cycles
    </h2>

    <% @closed_cycles.each do |entry| %>
      <div class="mb-6">
        <p class="text-xs font-semibold text-gray-500 uppercase mb-1">
          Cycle closed <%= entry[:cycle].closed_at.strftime("%d %b %Y") %> —
          Closing Balance:
          <span class="<%= entry[:cycle].closing_balance.negative? ? 'text-red-600' : 'text-green-700' %>">
            Rs. <%= number_with_delimiter(entry[:cycle].closing_balance.abs.round(2)) %>
          </span>
        </p>

        <table class="min-w-full text-sm border border-gray-200 rounded-lg overflow-hidden">
          <thead class="bg-gray-100">
            <tr>
              <th class="px-3 py-2 text-left text-xs font-semibold text-gray-600 uppercase">Date</th>
              <th class="px-3 py-2 text-left text-xs font-semibold text-gray-600 uppercase">Description</th>
              <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600 uppercase">Credit</th>
              <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600 uppercase">Debit</th>
              <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600 uppercase">Balance</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% entry[:transactions].each do |txn| %>
              <tr>
                <td class="px-3 py-2 text-gray-500"><%= txn.created_at.strftime("%d %b %Y") %></td>
                <td class="px-3 py-2 text-gray-700"><%= txn.sourceable.is_a?(SalesOrder) ? txn.sourceable.line_items_summary : txn.description %></td>
                <td class="px-3 py-2 text-right text-green-700"><%= "Rs. #{number_with_delimiter(txn.amount.round(2))}" if txn.credit? %></td>
                <td class="px-3 py-2 text-right text-red-600"><%= "Rs. #{number_with_delimiter(txn.amount.round(2))}" if txn.debit? %></td>
                <td class="px-3 py-2 text-right font-medium text-gray-900">Rs. <%= number_with_delimiter(txn.resulting_balance.round(2)) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
<% end %>

<!-- Product Sales -->
<% if @sales_orders.any? %>
  <div class="mb-8">
    <h2 class="text-base font-bold text-gray-900 mb-2 border-b border-gray-200 pb-1">
      Product Sales on Credit
    </h2>

    <table class="min-w-full text-sm border border-gray-200 rounded-lg overflow-hidden">
      <thead class="bg-gray-100">
        <tr>
          <th class="px-3 py-2 text-left text-xs font-semibold text-gray-600 uppercase">Order #</th>
          <th class="px-3 py-2 text-left text-xs font-semibold text-gray-600 uppercase">Date</th>
          <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600 uppercase">Amount</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @sales_orders.each do |order| %>
          <tr>
            <td class="px-3 py-2 font-mono text-gray-700"><%= order.order_number %></td>
            <td class="px-3 py-2 text-gray-500"><%= order.placed_at.strftime("%d %b %Y") %></td>
            <td class="px-3 py-2 text-right font-medium text-red-600">Rs. <%= number_with_delimiter(order.total_revenue.round(2)) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="bg-gray-50 border-t border-gray-200">
        <tr>
          <td colspan="2" class="px-3 py-2 text-sm font-semibold text-gray-700">Total Product Sales</td>
          <td class="px-3 py-2 text-right font-bold text-red-600">
            Rs. <%= number_with_delimiter(@sales_orders.sum(&:total_revenue).round(2)) %>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>
<% end %>

<!-- Footer -->
<div class="border-t border-gray-300 pt-4 mt-8 text-xs text-gray-400 flex justify-between">
  <span>This statement was generated by Grain CRM — <%= current_user.organization.name %></span>
  <span>Printed on <%= Time.current.strftime("%d %b %Y, %I:%M %p") %></span>
</div>
