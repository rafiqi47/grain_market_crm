<div class="max-w-xl mx-auto py-8">
  <h1 class="text-2xl font-semibold text-gray-900 mb-1">Edit Khata Entry</h1>
  <p class="text-gray-500 mb-6">
    <%= link_to @farmer.full_name, farmer_path(@farmer), class: "text-blue-600 hover:underline" %>
  </p>

  <% if @transaction.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-md p-4 mb-6">
      <ul class="list-disc list-inside text-sm">
        <% @transaction.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: [@farmer, @cycle, @transaction] do |f| %>
    <div class="space-y-4 bg-white border border-gray-200 rounded-lg p-6">

      <div>
        <%= f.label :entry_type, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :entry_type,
              [["Credit — we owe farmer more (e.g. crop delivered)", :credit],
               ["Debit — we owe farmer less (e.g. cash paid out)", :debit]],
              {}, class: "w-full rounded-md border-gray-300 shadow-sm" %>
      </div>

      <div>
        <%= f.label :amount, "Amount (Rs.)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :amount, min: 0, step: 0.01, class: "w-full rounded-md border-gray-300 shadow-sm" %>
      </div>

      <fieldset class="border border-gray-200 rounded-md p-4">
        <legend class="text-sm font-medium text-gray-700 px-1">Bardaana Adjustment (optional)</legend>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <%= f.label :bardaana_credit, "Bags we owe farmer (farmer supplied)", class: "block text-xs text-gray-500 mb-1" %>
            <%= f.number_field :bardaana_credit, min: 0, step: 1, class: "w-full rounded-md border-gray-300 shadow-sm" %>
          </div>
          <div>
            <%= f.label :bardaana_debit, "Bags farmer owes us (we supplied)", class: "block text-xs text-gray-500 mb-1" %>
            <%= f.number_field :bardaana_debit, min: 0, step: 1, class: "w-full rounded-md border-gray-300 shadow-sm" %>
          </div>
        </div>
        <p class="text-xs text-gray-400 mt-2">Current bardaana balance: <span class="font-medium"><%= @farmer.bardaana_balance %> bags</span></p>
      </fieldset>

      <div>
        <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :description, class: "w-full rounded-md border-gray-300 shadow-sm" %>
      </div>

      <div class="flex gap-3">
        <%= f.submit "Update Entry", class: "flex-1 bg-green-600 hover:bg-green-700 text-white font-medium rounded-md py-2 px-4 cursor-pointer" %>
        <%= link_to "Cancel", farmer_path(@farmer), class: "flex-1 text-center bg-white border border-gray-300 text-gray-700 font-medium rounded-md py-2 px-4" %>
      </div>
    </div>
  <% end %>

  <!-- Danger Zone -->
  <div class="mt-4 bg-white border border-red-200 rounded-lg p-4">
    <p class="text-sm text-gray-600 mb-3">Deleting this entry will permanently remove it and recalculate all balances.</p>
    <%= button_to "Delete This Entry",
          farmer_khata_cycle_khata_transaction_path(@farmer, @cycle, @transaction),
          method: :delete,
          data: { turbo_confirm: "Are you sure? This will permanently delete this entry and recalculate the Khata balance." },
          class: "w-full bg-red-600 hover:bg-red-700 text-white font-medium rounded-md py-2 px-4" %>
  </div>
</div>
