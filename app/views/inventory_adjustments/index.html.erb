<div class="p-6">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-black text-gray-900">Inventory Ledger</h1>
    <%= link_to "New Adjustment", new_inventory_adjustment_path, class: "bg-green-600 text-white px-4 py-2 rounded-lg font-bold hover:bg-green-700 transition" %>
  </div>

  <% if @unread_alerts.any? %>
    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-6">
      <p class="text-sm text-yellow-700"><strong>Alerts:</strong> You have <%= @unread_alerts.count %> pending inventory issues requiring attention.</p>
    </div>
  <% end %>

  <div class="bg-white shadow rounded-lg overflow-hidden border border-gray-200">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Product</th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Batch</th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Change</th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Reason</th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">User</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @adjustments.each do |adj| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= adj.product_batch.product.name %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= adj.product_batch.batch_number %></td>
            <td class="px-6 py-4 text-sm font-bold <%= adj.quantity_changed.positive? ? 'text-green-600' : 'text-red-600' %>">
              <%= adj.quantity_changed.positive? ? "+" : "" %><%= adj.quantity_changed %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= adj.adjustment_reason.humanize %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= adj.user.email %></td>
            <td class="px-6 py-4 text-sm">
              <%= link_to "Edit", edit_inventory_adjustment_path(adj), class: "text-blue-600 hover:text-blue-900 mr-4" %>
              <%= button_to "Reverse", reverse_inventory_adjustment_path(adj), 
                  method: :post,
                  data: { confirm: "Are you sure? This will create an opposing adjustment." },
                  class: "text-red-600 hover:text-red-900 font-semibold" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
