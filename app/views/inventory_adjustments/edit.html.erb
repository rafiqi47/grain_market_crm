<div class="max-w-2xl mx-auto p-6">
  <div class="bg-white shadow rounded-lg p-6 border border-gray-200">
    <h2 class="text-xl font-bold mb-6">Edit Adjustment Record</h2>

    <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-6">
      <p class="text-sm text-blue-700"><strong>Note:</strong> You are modifying the metadata for an existing adjustment. The stock quantity change cannot be edited here to preserve audit accuracy.</p>
    </div>

    <%= form_with model: @adjustment, url: inventory_adjustment_path(@adjustment), method: :patch, class: "space-y-4" do |f| %>
      <div>
        <label class="block text-sm font-semibold text-gray-700">Reason</label>
        <%= f.select :adjustment_reason,
            InventoryAdjustment.adjustment_reasons.keys.map { |r| [r.humanize, r] },
            {},
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-green-500" %>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700">Notes</label>
        <%= f.text_area :notes, rows: 3, class: "p-2 mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-green-500" %>
      </div>

      <div class="pt-4 flex justify-end gap-2">
        <%= link_to "Cancel", inventory_adjustments_path, class: "px-4 py-2 text-gray-600 hover:text-gray-900" %>
        <%= f.submit "Update Record", class: "bg-green-600 text-white px-6 py-2 rounded-lg font-bold hover:bg-green-700 transition" %>
      </div>
    <% end %>
  </div>
</div>
