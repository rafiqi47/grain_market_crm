<div class="max-w-3xl mx-auto my-8 px-4 sm:px-6">
  <div class="md:flex md:items-center md:justify-between mb-8 border-b border-gray-200 pb-5">
    <div class="flex-1 min-w-0">
      <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate tracking-tight">
        Log Stock Adjustment Event
      </h2>
      <p class="mt-1 text-sm text-gray-500">
        Manually adjust ledger entries for specific physical lot allocations to track anomalies, spoilage, or balancing adjustments.
      </p>
    </div>
  </div>

  <%= form_with url: inventory_adjustments_path, method: :post, local: true, class: "space-y-8" do |f| %>
    <div class="bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl md:col-span-2">
      <div class="px-4 py-6 sm:p-8 space-y-6">
        
        <div>
          <label for="product_batch_id" class="block text-sm font-semibold leading-6 text-gray-900">Select Target Inventory Lot</label>
          <div class="mt-2">
            <select name="product_batch_id" id="product_batch_id" required class="block w-full rounded-lg border-0 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-green-600 sm:text-sm sm:leading-6 transition bg-white">
              <option value="">-- Select Product Batch --</option>
              <% @batches.each do |batch| %>
                <option value="<%= batch.id %>">
                  <%= batch.product.name %> (Lot: <%= batch.batch_number %>) — Available Qty: <%= batch.quantity_on_hand %>
                </option>
              <% end %>
            </select>
          </div>
        </div>

        <div class="rounded-xl bg-amber-50 p-4 ring-1 ring-inset ring-amber-600/10">
          <div class="flex items-start gap-x-3">
            <svg class="h-5 w-5 text-amber-600 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
            <div>
              <h3 class="text-xs font-bold text-amber-800 tracking-wide uppercase">Delta Entry Protocol</h3>
              <p class="mt-1 text-sm leading-5 text-amber-700">
                Ledger logic calculates totals explicitly from changes. Input a negative value (<span class="font-mono bg-amber-100 px-1 py-0.5 rounded text-amber-900 font-bold">-2</span>) to deduct stock for shrinkage, damage, or returns. Use a positive number to add back inventory.
              </p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-6">
          <div class="sm:col-span-3">
            <label for="reason" class="block text-sm font-semibold leading-6 text-gray-900">Adjustment Event Reason</label>
            <div class="mt-2">
              <select name="reason" id="reason" required class="block w-full rounded-lg border-0 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-green-600 sm:text-sm sm:leading-6 transition bg-white">
                <option value="">-- Select Reason --</option>
                <% InventoryAdjustment.adjustment_reasons.keys.each do |key| %>
                  <option value="<%= key %>"><%= key.humanize %></option>
                <% end %>
              </select>
            </div>
          </div>

          <div class="sm:col-span-3">
            <label for="quantity_changed" class="block text-sm font-semibold leading-6 text-gray-900">Quantity Change (Delta)</label>
            <div class="mt-2">
              <%= f.number_field :quantity_changed, required: true, id: "quantity_changed", placeholder: "e.g., -5 or 12", class: "block w-full rounded-lg border-0 p-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-green-600 sm:text-sm sm:leading-6 transition" %>
            </div>
          </div>
        </div>

        <div>
          <label for="notes" class="block text-sm font-semibold leading-6 text-gray-900">Audit Notes / Explanatory Justification</label>
          <div class="mt-2">
            <%= f.text_area :notes, required: true, id: "notes", rows: 4, placeholder: "Describe exactly why this physical inventory reconciliation is occurring...", class: "block w-full rounded-lg border-0 p-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-green-600 sm:text-sm sm:leading-6 transition" %>
          </div>
        </div>

      </div>
    </div>

    <div class="flex items-center justify-end gap-x-4 border-t border-gray-900/10 pt-6">
      <%= f.submit "Commit Ledger Adjustment", class: "rounded-lg bg-green-600 px-5 py-3 text-sm font-semibold text-white shadow-md hover:bg-green-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600 transition-all cursor-pointer" %>
    </div>
  <% end %>
</div>
