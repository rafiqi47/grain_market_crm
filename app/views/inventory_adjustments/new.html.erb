<%
  sel_supplier     = params[:supplier_id].to_s
  sel_product      = params[:product_id].to_s
  sel_batch        = params[:product_batch_id].to_s
  sel_reason       = params[:reason].to_s
  sel_cust_type    = params[:customer_type].to_s
  sel_direction    = params[:direction].to_s
%>

<div class="max-w-2xl mx-auto py-8"
     data-controller="adjustment-form"
     data-adjustment-form-selected-supplier-id-value="<%= sel_supplier %>"
     data-adjustment-form-selected-product-id-value="<%= sel_product %>"
     data-adjustment-form-selected-batch-id-value="<%= sel_batch %>"
     data-adjustment-form-selected-reason-value="<%= sel_reason %>"
     data-adjustment-form-selected-customer-type-value="<%= sel_cust_type %>">

  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">New Inventory Adjustment</h1>
    <p class="text-xs text-gray-500 mt-1">Adjust stock levels and automatically update relevant ledgers.</p>
  </div>

  <% if flash[:alert] %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-md p-4 mb-6 text-sm">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_with url: inventory_adjustments_path, method: :post do %>

    <div class="space-y-5 bg-white border border-gray-200 rounded-lg p-6">

      <!-- Supplier -->
      <div>
        <label class="block text-xs font-bold text-gray-600 uppercase mb-1">1. Select Supplier</label>
        <select name="supplier_id"
                data-adjustment-form-target="supplierSelect"
                data-action="change->adjustment-form#supplierChanged"
                class="w-full rounded-md border-gray-300 shadow-sm text-sm">
          <option value="">— Select supplier —</option>
          <% @suppliers.each do |s| %>
            <option value="<%= s.id %>" <%= "selected" if s.id.to_s == sel_supplier %>>
              <%= s.name.titleize %>
            </option>
          <% end %>
        </select>
      </div>

      <!-- Product (populated via JS, shown if previously selected) -->
      <div data-adjustment-form-target="productWrapper"
           class="<%= sel_product.present? ? '' : 'hidden' %>">
        <label class="block text-xs font-bold text-gray-600 uppercase mb-1">2. Select Product</label>
        <select name="product_id"
                data-adjustment-form-target="productSelect"
                data-action="change->adjustment-form#productChanged"
                class="w-full rounded-md border-gray-300 shadow-sm text-sm">
          <option value="">— Select product —</option>
        </select>
      </div>

      <!-- Batch (populated via JS) -->
      <div data-adjustment-form-target="batchWrapper"
           class="<%= sel_batch.present? ? '' : 'hidden' %>">
        <label class="block text-xs font-bold text-gray-600 uppercase mb-1">3. Select Batch</label>
        <select name="product_batch_id"
                data-adjustment-form-target="batchSelect"
                data-action="change->adjustment-form#batchChanged"
                class="w-full rounded-md border-gray-300 shadow-sm text-sm">
          <option value="">— Select batch —</option>
        </select>
      </div>

      <!-- Quantity -->
      <div data-adjustment-form-target="quantityWrapper"
           class="<%= sel_batch.present? ? '' : 'hidden' %>">
        <label class="block text-xs font-bold text-gray-600 uppercase mb-1"
               data-adjustment-form-target="directionLabel">Quantity</label>

        <div data-adjustment-form-target="unitsField">
          <input type="number" name="quantity" min="0.01" step="0.01"
                 value="<%= params[:quantity] %>"
                 data-adjustment-form-target="quantityField"
                 placeholder="Enter quantity"
                 class="w-full rounded-md border-gray-300 shadow-sm text-sm">
        </div>

        <div data-adjustment-form-target="maundKgFields" class="hidden">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs text-gray-500 mb-1">Maund</label>
              <input type="number" name="quantity_maund" min="0" step="1"
                     value="<%= params[:quantity_maund] %>"
                     data-adjustment-form-target="maundField"
                     class="w-full rounded-md border-gray-300 shadow-sm text-sm">
            </div>
            <div>
              <label class="block text-xs text-gray-500 mb-1">KG</label>
              <input type="number" name="quantity_kg" min="0" max="39.99" step="0.01"
                     value="<%= params[:quantity_kg] %>"
                     data-adjustment-form-target="kgField"
                     class="w-full rounded-md border-gray-300 shadow-sm text-sm">
            </div>
          </div>
        </div>
      </div>

      <!-- Reason -->
      <div>
        <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Reason</label>
        <select name="reason"
                data-adjustment-form-target="reasonSelect"
                data-action="change->adjustment-form#reasonChanged"
                class="w-full rounded-md border-gray-300 shadow-sm text-sm">
          <option value="">— Select reason —</option>
          <option value="damaged_goods"        <%= "selected" if sel_reason == "damaged_goods" %>>Damaged Goods (deduct)</option>
          <option value="spillage_or_leakage"  <%= "selected" if sel_reason == "spillage_or_leakage" %>>Spillage / Leakage (deduct)</option>
          <option value="supplier_return"      <%= "selected" if sel_reason == "supplier_return" %>>Supplier Return (deduct + adjust supplier ledger)</option>
          <option value="customer_return"      <%= "selected" if sel_reason == "customer_return" %>>Customer Return (add back + adjust ledger)</option>
          <option value="audit_correction"     <%= "selected" if sel_reason == "audit_correction" %>>Audit Correction (manual direction)</option>
        </select>
      </div>

      <!-- Audit correction direction -->
      <div data-adjustment-form-target="directionWrapper"
           class="<%= sel_reason == 'audit_correction' ? '' : 'hidden' %>">
        <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Direction</label>
        <select name="direction" class="w-full rounded-md border-gray-300 shadow-sm text-sm">
          <option value="add"    <%= "selected" if sel_direction == "add" %>>Add to inventory (+)</option>
          <option value="deduct" <%= "selected" if sel_direction == "deduct" %>>Deduct from inventory (−)</option>
        </select>
      </div>

      <!-- Customer Return -->
      <div data-adjustment-form-target="customerReturnWrapper"
           class="<%= sel_reason == 'customer_return' ? '' : 'hidden' %> space-y-4 bg-blue-50 border border-blue-100 rounded-md p-4">
        <p class="text-xs font-bold text-blue-700 uppercase">Customer Return Details</p>

        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Return Value (Rs.)</label>
          <input type="number" name="return_value" min="0" step="0.01"
                 value="<%= params[:return_value] %>"
                 placeholder="Amount to credit back to customer"
                 class="w-full rounded-md border-gray-300 shadow-sm text-sm">
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Customer Type</label>
          <select name="customer_type"
                  data-adjustment-form-target="customerTypeSelect"
                  data-action="change->adjustment-form#customerTypeChanged"
                  class="w-full rounded-md border-gray-300 shadow-sm text-sm">
            <option value="">— Walk-in / No ledger adjustment —</option>
            <option value="farmer"          <%= "selected" if sel_cust_type == "farmer" %>>Farmer (adjust Khata)</option>
            <option value="trading_partner" <%= "selected" if sel_cust_type == "trading_partner" %>>Trading Partner (adjust ledger)</option>
          </select>
        </div>

        <div data-adjustment-form-target="farmerWrapper"
             class="<%= sel_cust_type == 'farmer' ? '' : 'hidden' %>">
          <label class="block text-xs font-semibold text-gray-600 mb-1">Select Farmer</label>
          <select name="farmer_id"
                  data-adjustment-form-target="farmerSelect"
                  class="w-full rounded-md border-gray-300 shadow-sm text-sm">
            <option value="">— Select farmer —</option>
            <% @farmers.each do |farmer| %>
              <option value="<%= farmer.id %>" <%= "selected" if params[:farmer_id].to_s == farmer.id.to_s %>>
                <%= farmer.full_name %><%= " / #{farmer.urdu_name}" if farmer.urdu_name.present? %>
                — Rs. <%= number_with_delimiter(farmer.current_balance.abs.round(2)) %>
              </option>
            <% end %>
          </select>
        </div>

        <div data-adjustment-form-target="tradingPartnerWrapper"
             class="<%= sel_cust_type == 'trading_partner' ? '' : 'hidden' %>">
          <label class="block text-xs font-semibold text-gray-600 mb-1">Select Trading Partner</label>
          <select name="trading_partner_id"
                  data-adjustment-form-target="tradingPartnerSelect"
                  class="w-full rounded-md border-gray-300 shadow-sm text-sm">
            <option value="">— Select trading partner —</option>
            <% @trading_partners.each do |partner| %>
              <option value="<%= partner.id %>" <%= "selected" if params[:trading_partner_id].to_s == partner.id.to_s %>>
                <%= partner.business_name.titleize %><%= " / #{partner.urdu_name}" if partner.urdu_name.present? %>
              </option>
            <% end %>
          </select>
        </div>
      </div>

      <!-- Supplier Return -->
      <div data-adjustment-form-target="supplierReturnWrapper"
           class="<%= sel_reason == 'supplier_return' ? '' : 'hidden' %> space-y-3 bg-amber-50 border border-amber-100 rounded-md p-4">
        <p class="text-xs font-bold text-amber-700 uppercase">Supplier Return Details</p>
        <p class="text-xs text-amber-600">Supplier is auto-detected from the selected batch. Stock will be deducted and a payment will be posted to their ledger.</p>
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Return Amount (Rs.)</label>
          <input type="number" name="supplier_return_amount" min="0" step="0.01"
                 value="<%= params[:supplier_return_amount] %>"
                 placeholder="Amount to deduct from supplier balance"
                 class="w-full rounded-md border-gray-300 shadow-sm text-sm">
        </div>
      </div>

      <!-- Notes -->
      <div>
        <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Notes</label>
        <textarea name="notes" rows="2"
                  placeholder="Additional notes"
                  class="w-full rounded-md border-gray-300 shadow-sm text-sm"><%= params[:notes] %></textarea>
      </div>

      <div class="flex gap-3 pt-2">
        <%= link_to "Cancel", inventory_adjustments_path,
              class: "flex-1 text-center px-4 py-2 text-sm font-medium text-gray-600 bg-white border border-gray-300 rounded-md hover:bg-gray-50" %>
        <button type="submit"
                class="flex-1 px-4 py-2 text-sm font-semibold text-white bg-gray-900 hover:bg-gray-700 rounded-md transition-colors">
          Record Adjustment
        </button>
      </div>

    </div>
  <% end %>
</div>
