<div style="font-family: sans-serif; color: #334155; line-height: 1.6; max-width: 600px; margin: 0 auto; padding: 20px;">

  <h2 style="color: #059669; margin-bottom: 16px;">GrainMarket CRM</h2>

  <p>Hello <%= @resource.full_name.presence || @resource.email %>,</p>

  <% if @resource.sign_in_count == 0 %>
    <%# New account setup — user has never signed in %>
    <p>An administrator has created an account for you. Please click the button below to set your password and activate your account.</p>
  <% else %>
    <%# Existing user requested a password reset %>
    <p>We received a request to reset the password for your account. Click the button below to choose a new password.</p>
    <p style="font-size: 14px; color: #64748b;">If you did not request this, you can safely ignore this email — your password will not change.</p>
  <% end %>

  <div style="margin: 32px 0; text-align: center;">
    <%= link_to(@resource.sign_in_count == 0 ? "Set Up Your Password" : "Reset My Password",
                edit_password_url(@resource, reset_password_token: @token),
                style: "background-color: #059669; color: white; padding: 12px 28px; text-decoration: none; border-radius: 6px; font-weight: 600; display: inline-block; font-size: 15px;") %>
  </div>

  <p style="font-size: 13px; color: #94a3b8;">
    This link will expire in <%= Devise.reset_password_within / 3600 %> hours for security purposes.
  </p>

  <p style="font-size: 13px; color: #94a3b8; margin-top: 24px;">
    Best regards,<br>GrainMarket CRM
  </p>
</div>
