<%# app/views/devise/mailer/reset_password_instructions.html.erb %>
<div style="font-family: sans-serif; color: #334155; line-height: 1.6; max-width: 600px; margin: 0 auto; padding: 20px;">
  <h2 style="color: #4f46e5; margin-bottom: 16px;">Welcome to Grain Market CRM!</h2>

  <p>Hello <%= @resource.email %>,</p>

  <p>An administrator has created an account for you as a manager/owner. To get started, please click the button below to set up your password and activate your profile.</p>

  <div style="margin: 32px 0; text-align: center;">
    <%= link_to 'Set Up Your Password',
                edit_password_url(@resource, reset_password_token: @token),
                style: "background-color: #4f46e5; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: 500; display: inline-block;" %>
  </div>

  <p style="font-size: 14px; color: #64748b;">This link will expire in a few hours for security purposes.</p>
  <p style="font-size: 14px; color: #64748b; margin-top: 24px;">Best regards,<br>The System Team</p>
</div>
