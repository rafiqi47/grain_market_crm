<div class="flex flex-col justify-center py-12 sm:px-6 lg:px-8 bg-gray-50 min-h-[calc(100vh-4rem)]">
  <div class="sm:mx-auto w-full max-w-md">
    <div class="text-center">
      <span class="text-3xl font-extrabold text-emerald-600 tracking-tight">GrainMarket</span>
      <span class="bg-emerald-100 text-emerald-800 text-xs font-semibold px-2 py-0.5 rounded ml-1">CRM</span>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">Sign in to your account</h2>
      <p class="mt-2 text-center text-sm text-gray-600">
        Access your enterprise trading dashboard
      </p>
    </div>
  </div>

  <div class="mt-8 sm:mx-auto w-full max-w-md">
    <div class="bg-white py-8 px-4 shadow sm:rounded-xl sm:px-10 border border-gray-100">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>

        <div>
          <%= f.label :email, class: "block text-xs font-semibold text-gray-700 uppercase tracking-wider" %>
          <div class="mt-1">
            <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
                              class: "appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm" %>
          </div>
        </div>

        <div>
          <%= f.label :password, class: "block text-xs font-semibold text-gray-700 uppercase tracking-wider" %>
          <div class="mt-1">
            <%= f.password_field :password, autocomplete: "current-password", required: true,
                              class: "appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm" %>
          </div>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <%= f.check_box :remember_me, class: "h-4 w-4 text-emerald-600 focus:ring-emerald-500 border-gray-300 rounded" %>
              <%= f.label :remember_me, class: "ml-2 block text-sm text-gray-900" %>
            </div>
          </div>
        <% end %>

        <div>
          <%# We use the is_submit: true flag so the component renders as a button element %>
          <%= f.button type: "submit", class: "w-full p-0 border-none bg-transparent cursor-pointer" do %>
            <%= custom_button(color: "primary", is_submit: true, full_width: true) { "Sign In" } %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
