<div class="flex flex-col justify-center py-12 sm:px-6 lg:px-8 bg-gray-50 min-h-[calc(100vh-4rem)]">
  <div class="sm:mx-auto w-full max-w-md">
    <div class="text-center">
      <span class="text-3xl font-extrabold text-emerald-600 tracking-tight">GrainMarket</span>
      <span class="bg-emerald-100 text-emerald-800 text-xs font-semibold px-2 py-0.5 rounded ml-1">CRM</span>
      <h2 class="mt-6 text-3xl font-extrabold text-gray-900">Reset your password</h2>
      <p class="mt-2 text-sm text-gray-600">
        Enter your email and we'll send you a reset link.
      </p>
    </div>
  </div>

  <div class="mt-8 sm:mx-auto w-full max-w-md">
    <div class="bg-white py-8 px-4 shadow sm:rounded-xl sm:px-10 border border-gray-100">

      <% if flash[:alert] %>
        <div class="mb-4 rounded-md bg-red-50 border border-red-200 p-3 text-sm text-red-700">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-6" }) do |f| %>

        <div>
          <%= f.label :email, class: "block text-xs font-semibold text-gray-700 uppercase tracking-wider" %>
          <div class="mt-1">
            <%= f.email_field :email,
                  autofocus: true,
                  autocomplete: "email",
                  required: true,
                  placeholder: "you@example.com",
                  class: "appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm" %>
          </div>
        </div>

        <div>
          <%= f.submit "Send Reset Instructions",
                class: "w-full flex justify-center py-2.5 px-4 border border-transparent rounded-md shadow-sm text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 cursor-pointer transition" %>
        </div>

      <% end %>

      <div class="mt-4 text-center text-sm">
        <%= link_to "← Back to Sign In", new_user_session_path,
              class: "text-emerald-600 hover:text-emerald-800 font-medium" %>
      </div>
    </div>
  </div>
</div>
