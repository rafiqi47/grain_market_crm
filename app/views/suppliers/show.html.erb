<div class="container mx-auto px-6 py-8" id="supplier_statement_space">

  <!-- Header -->
  <div class="flex justify-between items-center mb-6">
    <div>
      <%= link_to "← Back to Directory", suppliers_path, class: "text-xs font-semibold text-indigo-600 hover:text-indigo-800" %>
      <h1 class="text-3xl font-bold text-gray-900 capitalize mt-1"><%= @supplier.name %></h1>
      <p class="text-xs text-gray-500">Full transactional audit stream and active balance sheets.</p>
    </div>

    <div class="flex items-center space-x-3">
      <%= render "suppliers/balance_card", supplier: @supplier %>

      <%= link_to "Record Purchase", new_supplier_purchase_path(@supplier),
            class: "px-4 py-2.5 bg-green-600 text-white text-xs font-semibold rounded shadow hover:bg-green-700 transition-all" %>

      <%= link_to "Post Ledger Voucher", new_supplier_supplier_ledger_path(@supplier),
            class: "px-4 py-2.5 bg-gray-900 text-white text-xs font-semibold rounded shadow hover:bg-gray-800 transition-all",
            data: { turbo_frame: "modal" } %>
    </div>
  </div>

  <!-- Tabs -->
  <div data-controller="supplier-tabs">
    <div class="border-b border-gray-200 mb-6">
      <nav class="flex gap-1">
        <button data-action="click->supplier-tabs#show"
                data-supplier-tabs-target="tab"
                data-tab="products"
                class="px-5 py-2.5 text-sm font-semibold rounded-t-lg border-b-2 border-gray-900 text-gray-900 bg-white transition-colors">
          Products
          <span class="ml-1.5 text-xs bg-gray-100 text-gray-600 px-1.5 py-0.5 rounded-full font-medium">
            <%= @products.size %>
          </span>
        </button>
        <button data-action="click->supplier-tabs#show"
                data-supplier-tabs-target="tab"
                data-tab="ledger"
                class="px-5 py-2.5 text-sm font-semibold rounded-t-lg border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 transition-colors">
          Ledger
          <span class="ml-1.5 text-xs bg-gray-100 text-gray-500 px-1.5 py-0.5 rounded-full font-medium">
            <%= @ledger_entries.size %>
          </span>
        </button>
      </nav>
    </div>

    <!-- Products Tab -->
    <div data-supplier-tabs-target="panel" data-panel="products">
      <div class="bg-white shadow-sm rounded-lg overflow-hidden border border-gray-200">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-100">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Product</th>
              <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Category</th>
              <th class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Active Batches</th>
              <th class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Total Stock</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white">
            <% if @products.any? %>
              <% @products.each do |product| %>
                <tr class="hover:bg-gray-50 transition-colors cursor-pointer"
                    onclick="loadSupplierProduct(<%= @supplier.id %>, <%= product.id %>)">
                  <td class="px-6 py-3">
                    <div class="flex items-center gap-2">
                      <span class="font-semibold text-gray-900"><%= product.name %></span>
                      <% if product.slug.present? %>
                        <span class="text-xs px-1.5 py-0.5 bg-slate-100 text-slate-700 rounded font-medium"
                              dir="rtl" style="font-family: 'Noto Nastaliq Urdu', serif;">
                          <%= product.slug %>
                        </span>
                      <% end %>
                    </div>
                    <p class="text-xs text-gray-400 font-mono mt-0.5"><%= product.sku %></p>
                  </td>
                  <td class="px-6 py-3 text-xs text-gray-600 capitalize"><%= product.category.humanize %></td>
                  <td class="px-6 py-3 text-right text-gray-700 font-medium">
                    <%= product.product_batches.active.count %>
                  </td>
                  <td class="px-6 py-3 text-right font-semibold text-gray-900">
                    <% if %w[seed oil_cake wanda].include?(product.category) %>
                      <% total_kg = product.product_batches.active.sum(:quantity_on_hand) %>
                      <% maund = (total_kg / 40).to_i %>
                      <% kg = (total_kg % 40).round(2) %>
                      <%= maund %>M <%= kg %>KG
                    <% else %>
                      <%= product.total_quantity_on_hand %> bags
                    <% end %>
                  </td>
                </tr>
                <!-- Detail frame injected below each product row -->
                <tr>
                  <td colspan="4" class="p-0">
                    <turbo-frame id="supplier-product-<%= product.id %>"></turbo-frame>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="4" class="px-6 py-10 text-center text-sm text-gray-400">
                  No products yet.
                  <%= link_to "Record a purchase", new_supplier_purchase_path(@supplier), class: "text-green-600 hover:underline font-medium" %>
                  to add products.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Ledger Tab -->
    <div data-supplier-tabs-target="panel" data-panel="ledger" class="hidden">
      <div class="bg-white shadow rounded-lg overflow-hidden border border-gray-200">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Balance</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200 font-mono text-sm">
            <% if @ledger_entries.any? %>
              <% @ledger_entries.each do |entry| %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-500">
                    <%= entry.created_at.strftime("%b %d, %Y - %I:%M %p") %>
                  </td>
                  <td class="px-6 py-4 text-xs text-gray-700 font-sans"><%= entry.description %></td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="px-2 inline-flex text-[10px] leading-5 font-bold rounded-full <%= entry.purchase? ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800' %> uppercase">
                      <%= entry.entry_type %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right font-bold <%= entry.purchase? ? 'text-amber-700' : 'text-emerald-700' %>">
                    <%= entry.purchase? ? '+' : '-' %> Rs. <%= number_with_delimiter(entry.amount) %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right text-gray-900 font-bold">
                    Rs. <%= number_with_delimiter(entry.resulting_balance) %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right text-xs font-sans font-medium space-x-2">
                    <%= link_to "Edit", edit_supplier_supplier_ledger_path(@supplier, entry),
                          class: "text-indigo-600 hover:text-indigo-900",
                          data: { turbo_frame: "modal" } %>
                    <%= link_to "Delete", supplier_supplier_ledger_path(@supplier, entry),
                          class: "text-red-600 hover:text-red-900 font-medium",
                          data: { turbo_method: :delete, turbo_confirm: "Are you sure? This will recalculate all balances." } %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="px-6 py-10 text-center text-gray-500 font-sans text-sm bg-gray-50">
                  No financial records posted yet.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>

<%= turbo_frame_tag "modal" %>

<script>
  let openProductId = null

  function loadSupplierProduct(supplierId, productId) {
    const frame = document.getElementById(`supplier-product-${productId}`)

    // Toggle closed if same row clicked again
    if (openProductId === productId) {
      frame.innerHTML = ""
      openProductId = null
      return
    }

    // Close previously open product
    if (openProductId !== null) {
      const prevFrame = document.getElementById(`supplier-product-${openProductId}`)
      if (prevFrame) prevFrame.innerHTML = ""
    }

    // Load via Turbo Frame
    frame.src = `/suppliers/${supplierId}/products/${productId}`
    openProductId = productId
  }
</script>
