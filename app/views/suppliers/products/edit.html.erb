<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-sm">
    <div class="bg-white rounded-xl shadow-xl border border-slate-200 w-full max-w-lg overflow-hidden">

      <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
        <div>
          <h3 class="text-base font-bold text-slate-900">Edit Product</h3>
          <p class="text-xs text-slate-500 mt-0.5">Linked to <%= @supplier.name.titleize %></p>
        </div>
        <button type="button"
                onclick="document.getElementById('modal').innerHTML = ''"
                class="text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-100 transition-colors">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <div class="p-6">
        <% if @product.errors.any? %>
          <div class="bg-red-50 border border-red-200 text-red-700 rounded-md p-3 mb-4 text-xs">
            <%= @product.errors.full_messages.to_sentence %>
          </div>
        <% end %>

        <%= form_with model: [@supplier, @product],
              url: supplier_product_path(@supplier, @product),
              method: :patch do |f| %>
          <div class="space-y-4">

            <div>
              <%= f.label :name, "Product Name", class: "block text-xs font-semibold text-gray-700 mb-1" %>
              <%= f.text_field :name, required: true,
                    class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" %>
            </div>

            <div data-controller="urdu-keyboard">
              <%= f.label :slug, "اردو نام", class: "block text-xs font-semibold text-gray-700 mb-1" %>
              <%= f.text_field :slug,
                    dir: "rtl",
                    placeholder: "یہاں اردو نام لکھیں",
                    style: "font-family: 'Noto Nastaliq Urdu', serif; font-size: 16px;",
                    data: {
                      urdu_keyboard_target: "input",
                      action: "focus->urdu-keyboard#focusField blur->urdu-keyboard#blurField"
                    },
                    class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm outline-none text-right" %>
              <div data-urdu-keyboard-target="keyboard"></div>
            </div>

            <div>
              <%= f.label :category, class: "block text-xs font-semibold text-gray-700 mb-1" %>
              <%= f.select :category,
                    Product.categories.keys.map { |c| [c.humanize, c] },
                    {},
                    class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none",
                    onchange: "updateUnitField(this.value)" %>
            </div>

            <!-- Unit field — restricted by category -->
            <div>
              <%= f.label :unit, "Unit", class: "block text-xs font-semibold text-gray-700 mb-1" %>
              <%
                current_cat    = @product.category.to_s
                allowed_units  = Product::ALLOWED_UNITS[current_cat] || []
                single_unit    = allowed_units.size == 1
              %>
              <div id="unit-auto-display"
                   class="<%= single_unit ? '' : 'hidden' %> w-full rounded-lg border border-gray-100 bg-gray-100 px-3 py-2 text-sm text-gray-600">
                <%= allowed_units.first %>
                <span class="text-xs text-gray-400">(auto-set for <%= current_cat.humanize %>)</span>
              </div>
              <%= f.hidden_field :unit,
                    id: "unit-hidden-field",
                    value: single_unit ? allowed_units.first : @product.unit %>
              <select id="unit-dropdown-select"
                      name="product[unit]"
                      class="<%= single_unit ? 'hidden' : '' %> w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 outline-none">
                <% allowed_units.each do |u| %>
                  <option value="<%= u %>" <%= "selected" if @product.unit.to_s == u %>>
                    <%= u %>
                  </option>
                <% end %>
              </select>
            </div>

            <div>
              <%= f.label :reorder_threshold, "Reorder Threshold", class: "block text-xs font-semibold text-gray-700 mb-1" %>
              <%= f.number_field :reorder_threshold, min: 0,
                    class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" %>
            </div>

            <div class="flex gap-3 pt-2">
              <button type="button"
                      onclick="document.getElementById('modal').innerHTML = ''"
                      class="flex-1 px-4 py-2 text-sm font-medium text-gray-600 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
                Cancel
              </button>
              <%= f.submit "Update Product",
                    class: "flex-1 px-4 py-2 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-md cursor-pointer" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <script>
    const ALLOWED_UNITS_MAP = <%= Product::ALLOWED_UNITS.to_json.html_safe %>;

    function updateUnitField(category) {
      const units      = ALLOWED_UNITS_MAP[category] || [];
      const autoDiv    = document.getElementById("unit-auto-display");
      const hiddenEl   = document.getElementById("unit-hidden-field");
      const selectEl   = document.getElementById("unit-dropdown-select");

      if (units.length === 1) {
        autoDiv.textContent  = `${units[0]} (auto-set for ${category})`;
        autoDiv.classList.remove("hidden");
        hiddenEl.value       = units[0];
        hiddenEl.name        = "product[unit]";
        selectEl.classList.add("hidden");
        selectEl.name        = "";
      } else {
        autoDiv.classList.add("hidden");
        hiddenEl.name        = "";
        hiddenEl.value       = "";
        selectEl.innerHTML   = units.map(u => `<option value="${u}">${u}</option>`).join("");
        selectEl.classList.remove("hidden");
        selectEl.name        = "product[unit]";
      }
    }
  </script>
<% end %>
