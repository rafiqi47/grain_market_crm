<!-- app/views/suppliers/_table.html.erb -->
<div class="bg-white shadow rounded-lg overflow-hidden border border-gray-200">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Supplier Name</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Classification</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Contact Info</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Products Linked</th>
        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% if suppliers.any? %>
        <% suppliers.each do |supplier| %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-900 capitalize">
              <%= supplier.name %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-slate-100 text-slate-800 uppercase">
                <%= supplier.company_type.humanize %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
              <div class="text-gray-900 font-medium"><%= supplier.phone.presence || '—' %></div>
              <div class="text-xs text-gray-400"><%= supplier.email.presence || 'No Email Added' %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= supplier.products.count %> categorized lines
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to "Edit", edit_supplier_path(supplier), class: "text-indigo-600 hover:text-indigo-900 transition-colors", data: { turbo_frame: "modal" } %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="5" class="px-6 py-10 text-center text-sm text-gray-500 bg-gray-50">
            No suppliers have been registered for this organization yet.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
