<!-- app/views/suppliers/_table.html.erb -->
<div class="bg-white shadow rounded-lg overflow-hidden border border-gray-200">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Supplier Name</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Classification</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Contact Info</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Products</th>
        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Current Balance</th>
        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% if suppliers.any? %>
        <% suppliers.each do |supplier| %>
          <tr class="hover:bg-gray-50 transition-colors cursor-pointer" onclick="window.location='<%= supplier_path(supplier) %>'">
            <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-900 capitalize">
              <%= supplier.name %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-slate-100 text-slate-800 uppercase">
                <%= supplier.company_type.humanize %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
              <div class="text-gray-900 font-medium"><%= supplier.phone.presence || '—' %></div>
              <div class="text-xs text-gray-400"><%= supplier.email.presence || 'No Email Added' %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= supplier.products.count %> lines
            </td>
            <!-- Real-time dynamic balance indicator -->
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-bold <%= supplier.current_balance > 0 ? 'text-red-600' : 'text-emerald-700' %>">
              <%= number_to_currency(supplier.current_balance, unit: "Rs. ", precision: 0) %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-3">
              <!-- Statement View Route (Breaks out of Hotwire modal frame targeting top level) -->
              <%= link_to "Statement", supplier_path(supplier), class: "text-indigo-600 hover:text-indigo-900 transition-colors font-semibold", data: { turbo_frame: "_top" }, onclick: "event.stopPropagation()" %>

              <%= link_to "Edit", edit_supplier_path(supplier), class: "text-gray-500 hover:text-gray-700 transition-colors", data: { turbo_frame: "modal" }, onclick: "event.stopPropagation()" %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="6" class="px-6 py-10 text-center text-sm text-gray-500 bg-gray-50">
            No suppliers have been registered for this organization yet.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
