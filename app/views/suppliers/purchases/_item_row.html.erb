<% submitted_item ||= nil %>
<% s = submitted_item || {} %>

<div class="purchase-row px-6 py-5 bg-white hover:bg-gray-50/50 transition-colors">
  <input type="hidden" name="items[<%= index %>][category]" class="row-category" value="<%= s["category"] %>">

  <div class="grid grid-cols-12 gap-3 items-start">

    <!-- Product Select (col 4) -->
    <div class="col-span-4">
      <label class="block text-xs font-semibold text-gray-600 mb-1">Product</label>
      <div class="flex gap-2">
        <select name="items[<%= index %>][product_id]"
                data-action="change->purchase-form#productChanged"
                class="product-select flex-1 rounded-md border-gray-300 shadow-sm text-sm">
          <option value="">— Select product —</option>
          <% products.each do |product| %>
            <option value="<%= product.id %>"
                    data-category="<%= product.category %>"
                    <%= "selected" if s["product_id"].to_s == product.id.to_s %>>
              <%= product.name %>
            </option>
          <% end %>
        </select>

        <!-- Quick add new product button -->
        <button type="button"
                data-action="click->product-modal#open"
                data-row-index="<%= index %>"
                title="Add new product"
                class="flex-shrink-0 px-2 py-1.5 bg-indigo-50 text-indigo-600 border border-indigo-200 rounded-md hover:bg-indigo-100 transition-colors text-xs font-bold">
          + New
        </button>
      </div>
    </div>

    <!-- NON-COMMODITY: Quantity, Batch, Manufacture, Expiry -->
    <div class="col-span-7 non-commodity-fields">
      <div class="grid grid-cols-4 gap-3">
       <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Qty (bags)</label>
          <input type="number" name="items[<%= index %>][quantity]" min="1" step="1"
                 value="<%= s["quantity"] %>"
                 data-action="input->purchase-form#recalculate"
                 class="qty-field w-full rounded-md border-gray-300 shadow-sm text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1 price-label">Price / Unit</label>
          <input type="number" name="items[<%= index %>][price_non_commodity]" min="0" step="0.01"
                 value="<%= s["price_non_commodity"] %>"
                 data-action="input->purchase-form#recalculate"
                 class="price-field w-full rounded-md border-gray-300 shadow-sm text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Batch No.</label>
          <input type="text" name="items[<%= index %>][batch_number]"
                 value="<%= s["batch_number"] %>"
                 placeholder="e.g. B-001"
                 class="w-full rounded-md border-gray-300 shadow-sm text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Expiry Date</label>
          <input type="date" name="items[<%= index %>][expiry_date]"
                 value="<%= s["expiry_date"] %>"
                 class="w-full rounded-md border-gray-300 shadow-sm text-sm">
        </div>
      </div>
      <div class="grid grid-cols-4 gap-3 mt-2">
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Mfg. Date</label>
          <input type="date" name="items[<%= index %>][manufacture_date]"
                 value="<%= s["manufacture_date"] %>"
                 class="w-full rounded-md border-gray-300 shadow-sm text-sm">
        </div>
        <div class="col-span-3 flex items-end">
          <p class="text-xs text-gray-400 pb-2">Line total: <span class="line-total font-semibold text-gray-700">—</span></p>
        </div>
      </div>
    </div>

    <!-- COMMODITY: Maund + KG + Price per Maund -->
    <div class="col-span-7 commodity-fields hidden">
      <div class="grid grid-cols-4 gap-3">
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Maund</label>
          <input type="number" name="items[<%= index %>][quantity_maund]" min="0" step="1"
                 value="<%= s["quantity_maund"] %>"
                 data-action="input->purchase-form#recalculate"
                 class="qty-maund w-full rounded-md border-gray-300 shadow-sm text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">KG</label>
          <input type="number" name="items[<%= index %>][quantity_kg]" min="0" max="39.99" step="0.01"
                 value="<%= s["quantity_kg"] %>"
                 data-action="input->purchase-form#recalculate"
                 class="qty-kg w-full rounded-md border-gray-300 shadow-sm text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1 price-label">Price / Maund</label>
          <input type="number" name="items[<%= index %>][price_commodity]" min="0" step="0.01"
                 value="<%= s["price_commodity"] %>"
                 data-action="input->purchase-form#recalculate"
                 class="price-field w-full rounded-md border-gray-300 shadow-sm text-sm">
        </div>
        <div class="flex items-end">
          <p class="text-xs text-gray-400 pb-2">Total: <span class="line-total font-semibold text-gray-700">—</span></p>
        </div>
      </div>
    </div>

    <!-- Remove button (col 1) -->
    <div class="col-span-1 flex items-end justify-end pb-2">
      <button type="button"
              data-action="click->purchase-form#removeRow"
              class="p-1.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-md transition-colors"
              title="Remove row">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

  </div>
</div>
