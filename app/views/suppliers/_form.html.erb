<!-- app/views/suppliers/_form.html.erb -->
<%= form_with(model: supplier, class: "space-y-5", data: { turbo_frame: "_top" }) do |f| %>
  <% if supplier.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 p-3.5 rounded-lg text-xs font-medium">
      <%= supplier.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <!-- Row 1: Full Name -->
  <div class="space-y-1.5">
    <%= f.label :name, "Supplier Name", class: "block text-[11px] font-bold tracking-wider text-gray-500 uppercase" %>
    <%= f.text_field :name,
        class: "block w-full rounded-lg border border-gray-200 bg-gray-50/50 px-3.5 py-2 text-sm text-gray-900 placeholder-gray-400 shadow-sm transition-all focus:border-indigo-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500", 
        placeholder: "e.g. AgriTrade Solutions",
        required: true %>
  </div>

  <!-- Row 2: Two Column Contact Info -->
  <div class="space-y-1.5">
    <div class="flex justify-between items-center">
      <%= f.label :phone, "Phone Number", class: "block text-[11px] font-bold tracking-wider text-gray-500 uppercase" %>
      <span class="text-[10px] text-gray-400 font-medium">11 digits (e.g. 03001234567)</span>
    </div>
    <%= f.telephone_field :phone,
        class: "block w-full rounded-lg border border-gray-200 bg-gray-50/50 px-3.5 py-2 text-sm text-gray-900 placeholder-gray-400 shadow-sm transition-all focus:border-indigo-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500",
        placeholder: "03000000000",
        pattern: "^$|\\d{11}",
        title: "If provided, the phone number must be exactly 11 numeric digits.",
        oninput: "this.setCustomValidity(this.validity.patternMismatch ? 'Phone number must be exactly 11 digits.' : '')" %>
  </div>

  <div class="space-y-1.5">
    <%= f.label :email, "Email Address", class: "block text-[11px] font-bold tracking-wider text-gray-500 uppercase" %>
    <%= f.email_field :email,
        class: "block w-full rounded-lg border border-gray-200 bg-gray-50/50 px-3.5 py-2 text-sm text-gray-900 placeholder-gray-400 shadow-sm transition-all focus:border-indigo-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500",
        placeholder: "contact@supplier.com" %>
  </div>

  <!-- Row 3: Dropdown Selector -->
  <div class="space-y-1.5">
    <%= f.label :company_type, "Supplier Classification Type", class: "block text-[11px] font-bold tracking-wider text-gray-500 uppercase" %>
    <div class="relative">
      <%= f.select :company_type,
          Supplier.company_types.keys.map { |k| [k.humanize, k] },
          {},
          { class: "block w-full appearance-none rounded-lg border border-gray-200 bg-gray-50/50 px-3.5 py-2 pr-10 text-sm text-gray-900 shadow-sm transition-all focus:border-indigo-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500 cursor-pointer" } %>
      <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3.5 text-gray-400">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Actions Panel -->
  <div class="flex justify-end gap-2.5 pt-4 border-t border-gray-100">
    <button type="button"
        onclick="let frame = this.closest('turbo-frame'); frame.src = ''; frame.innerHTML = '';"
        class="px-4 py-2 text-xs font-semibold text-gray-600 bg-gray-50 rounded-lg border border-gray-200 shadow-sm hover:bg-gray-100 transition-colors">
      Cancel
    </button>
    <%= f.submit supplier.new_record? ? "Save Supplier" : "Update Supplier",
        class: "px-4 py-2 text-xs font-semibold text-white bg-indigo-600 rounded-lg shadow-sm hover:bg-indigo-700 transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
  </div>
<% end %>
