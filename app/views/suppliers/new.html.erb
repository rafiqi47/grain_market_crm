<!-- app/views/suppliers/new.html.erb -->
<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 bg-gray-600 bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl p-6 w-full max-w-md border border-gray-200">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-bold text-gray-900">Add New Supplier</h3>
        <%= link_to "×", suppliers_path, class: "text-gray-400 hover:text-gray-600 text-2xl font-semibold", data: { turbo_frame: "_top" } %>
      </div>

      <%= render "form", supplier: @supplier %>
    </div>
  </div>
<% end %>
