<!-- app/views/suppliers/supplier_ledgers/_form.html.erb -->
<%= form_with(model: [supplier, ledger], class: "space-y-4") do |f| %>
  <% if ledger.errors.any? %>
    <div class="bg-red-50 text-red-700 p-3 rounded text-xs">
      <%= ledger.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :entry_type, "Voucher Type", class: "block text-xs font-semibold text-gray-600 uppercase" %>
    <%= f.select :entry_type, SupplierLedger.entry_types.keys.map { |k| [k.humanize, k] }, {}, class: "mt-1 block w-full rounded border-gray-300 shadow-sm text-sm" %>
  </div>

  <div>
    <%= f.label :amount, "Transaction Amount (PKR)", class: "block text-xs font-semibold text-gray-600 uppercase" %>
    <%= f.number_field :amount, min: 0.01, step: "0.01", class: "mt-1 block w-full rounded border-gray-300 shadow-sm text-sm", required: true %>
  </div>

  <div>
    <%= f.label :description, "Remarks / Reference Details", class: "block text-xs font-semibold text-gray-600 uppercase" %>
    <%= f.text_field :description, placeholder: "e.g., Cash paid via bank transfer receipt #1203", class: "mt-1 block w-full rounded border-gray-300 shadow-sm text-sm", required: true %>
  </div>

  <div class="flex justify-end gap-2 pt-2">
    <button type="button"
        class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded hover:bg-gray-200 cursor-pointer" 
        onclick="let frame = this.closest('turbo-frame'); if(frame) { frame.src = ''; frame.innerHTML = ''; }">
      Cancel
    </button>
    <%= f.submit "Save Voucher", class: "px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded hover:bg-indigo-700 cursor-pointer" %>
  </div>
<% end %>
