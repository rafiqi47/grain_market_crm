<!-- app/views/product_batches/_form.html.erb -->
<%= form_with(model: [product, product_batch], class: "space-y-4") do |f| %>
  <% if product_batch.errors.any? %>
    <div class="bg-red-50 text-red-700 p-3 rounded text-xs">
      <%= product_batch.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :batch_number, "Lot / Batch #", class: "block text-xs font-semibold text-gray-600 uppercase" %>
      <%= f.text_field :batch_number, placeholder: "ENG-DAP-01", class: "mt-1 block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm", required: true %>
    </div>
    
    <% if product_batch.new_record? %>
      <div>
        <%= f.label :initial_quantity, "Initial Bags Qty", class: "block text-xs font-semibold text-gray-600 uppercase" %>
        <%= f.number_field :initial_quantity, min: 1, class: "mt-1 block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm", required: true %>
      </div>
    <% else %>
      <div>
        <%= f.label :quantity_on_hand, "Current Stock Left", class: "block text-xs font-semibold text-gray-600 uppercase" %>
        <%= f.number_field :quantity_on_hand, min: 0, class: "mt-1 block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm", required: true %>
      </div>
    <% end %>
  </div>

  <% unless product_batch.new_record? %>
    <div>
      <%= f.label :initial_quantity, "Initial Qty Logs", class: "block text-xs font-semibold text-gray-600 uppercase" %>
      <%= f.number_field :initial_quantity, min: 1, class: "mt-1 block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm", required: true %>
    </div>
  <% end %>

  <div>
    <%= f.label :purchase_price_per_unit, "Purchase Cost Per Bag", class: "block text-xs font-semibold text-gray-600 uppercase" %>
    <%= f.number_field :purchase_price_per_unit, step: "0.01", min: "0", class: "mt-1 block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm", required: true %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :manufacture_date, "Mfg Date", class: "block text-xs font-semibold text-gray-600 uppercase" %>
      <%= f.date_field :manufacture_date, class: "mt-1 block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
    </div>
    <div>
      <%= f.label :expiry_date, "Expiry Date", class: "block text-xs font-semibold text-gray-600 uppercase" %>
      <%= f.date_field :expiry_date, class: "mt-1 block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm", required: true %>
    </div>
  </div>

  <div class="flex justify-end gap-2 pt-2">
    <%= link_to "Cancel", "#", class: "px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded hover:bg-gray-200", data: { turbo_frame: "modal" } %>
    <%= f.submit submit_label, class: "px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded hover:bg-indigo-700" %>
  </div>
<% end %>