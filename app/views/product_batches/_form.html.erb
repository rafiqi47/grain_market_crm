<!-- app/views/product_batches/_form.html.erb -->
<%= form_with(model: [product, product_batch], class: "space-y-4") do |f| %>
  <% if product_batch.errors.any? %>
    <div class="bg-red-50 text-red-700 p-3 rounded text-xs">
      <%= product_batch.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :batch_number, "Lot / Batch #", class: "block text-xs font-semibold text-gray-600 uppercase" %>
      <%= f.text_field :batch_number, placeholder: "ENG-DAP-01", class: "mt-1 block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm", required: true %>
    </div>
    
    <% if product_batch.new_record? %>
      <div>
        <%= f.label :initial_quantity, "Initial Bags Qty", class: "block text-xs font-semibold text-gray-600 uppercase" %>
        <%= f.number_field :initial_quantity, min: 1, id: "batch_initial_qty", class: "mt-1 block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm", required: true %>
      </div>
    <% else %>
      <div>
        <%= f.label :quantity_on_hand, "Current Stock Left", class: "block text-xs font-semibold text-gray-600 uppercase" %>
        <%= f.number_field :quantity_on_hand, min: 0, class: "mt-1 block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm", required: true %>
      </div>
    <% end %>
  </div>

  <div>
    <%= f.label :purchase_price_per_unit, "Purchase Cost Per Bag (PKR)", class: "block text-xs font-semibold text-gray-600 uppercase" %>
    <%= f.number_field :purchase_price_per_unit, step: "0.01", min: "0", id: "batch_unit_cost", class: "mt-1 block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm", required: true %>
  </div>

  <% if product_batch.new_record? %>
    <!-- NEW SECTION: Automated Financial Split Layer (Khaata Allocation) -->
    <div class="bg-slate-50 p-3 rounded-lg border border-slate-200 space-y-3">
      <span class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider">Financial Agreement Structure</span>
      
      <div>
        <label for="amount_paid" class="block text-xs font-semibold text-gray-600 uppercase">Amount Paid Upfront (Cash/Bank)</label>
        <input type="number" name="financials[amount_paid]" id="batch_amount_paid" value="0" min="0" step="0.01" class="mt-1 block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" required>
      </div>

      <div class="pt-1 border-t border-slate-200 flex justify-between text-xs text-gray-500 font-medium">
        <span>Estimated Total Value:</span>
        <span id="calculated_total_cost" class="font-bold text-gray-900 font-mono">Rs. 0</span>
      </div>
    </div>

    <!-- Client-Side Real-Time Calculator Script -->
    <script>
      (function() {
        const qtyInput = document.getElementById("batch_initial_qty");
        const costInput = document.getElementById("batch_unit_cost");
        const totalDisplay = document.getElementById("calculated_total_cost");

        function calculate() {
          const qty = parseFloat(qtyInput.value) || 0;
          const cost = parseFloat(costInput.value) || 0;
          totalDisplay.textContent = "Rs. " + Math.round(qty * cost).toLocaleString();
        }

        if (qtyInput && costInput) {
          // 1. Listen for dynamic changes as the trader types
          qtyInput.addEventListener("input", calculate);
          costInput.addEventListener("input", calculate);

          // 2. Run immediately to catch values if fields are pre-filled or edited
          calculate();
        }
      })();
    </script>
  <% end %>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :manufacture_date, "Mfg Date", class: "block text-xs font-semibold text-gray-600 uppercase" %>
      <%= f.date_field :manufacture_date, class: "mt-1 block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
    </div>
    <div>
      <%= f.label :expiry_date, "Expiry Date", class: "block text-xs font-semibold text-gray-600 uppercase" %>
      <%= f.date_field :expiry_date, class: "mt-1 block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm", required: true %>
    </div>
  </div>

  <div class="flex justify-end gap-2 pt-2">
    <%= link_to "Cancel", "#", class: "px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded hover:bg-gray-200", data: { turbo_frame: "modal" } %>
    <%= f.submit submit_label, class: "px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded hover:bg-indigo-700 cursor-pointer" %>
  </div>
<% end %>
