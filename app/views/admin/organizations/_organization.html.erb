<tr class="organization-row hover:bg-slate-50/70 transition-colors duration-150 group"
    data-search-name="<%= organization.name.downcase %>">

  <td class="whitespace-nowrap py-4 pl-6 pr-3 text-sm font-medium text-slate-900">
    <div class="flex items-center gap-3">
      <div class="h-8 w-8 rounded-md bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 font-bold text-xs uppercase shadow-sm flex-shrink-0">
        <%= organization.name[0..1] %>
      </div>
      <span class="font-semibold text-slate-800 group-hover:text-indigo-600 transition-colors duration-150">
        <%= organization.name %>
      </span>
    </div>
  </td>

  <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500">
    <% if organization.owner.present? %>
      <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">
        <%= organization.owner.full_name %>
      </span>
    <% else %>
      <span class="text-xs italic text-slate-400 font-normal">No Owner Assigned</span>
    <% end %>
  </td>

  <td class="px-3 py-4 text-sm text-slate-500">
    <% if organization.managers.any? %>
      <div class="flex flex-wrap gap-1.5 max-w-md">
        <% organization.managers.each do |manager| %>
          <span class="inline-flex items-center rounded-md bg-sky-50 px-2 py-0.5 text-xs font-medium text-sky-700 ring-1 ring-inset ring-sky-600/10">
            <%= manager.full_name %>
          </span>
        <% end %>
      </div>
    <% else %>
      <span class="text-xs italic text-slate-400 font-normal">None</span>
    <% end %>
  </td>

  <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
    <div class="flex items-center justify-end">
      <%= button_to admin_organization_path(organization),
        method: :post,
        class: "text-xs text-slate-600 font-semibold bg-transparent border-0 p-0 cursor-pointer" do %>
        Send Invite
      <% end %>
      <%= link_to admin_organization_path(organization),
                  data: { turbo_frame: "_top", turbo_prefetch: "false" },
                  title: "View Details",
                  class: "p-1.5 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-slate-100 transition-all duration-150 flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-indigo-500/20" do %>
        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        </svg>
      <% end %>
    </div>
  </td>
</tr>
