<div class="p-6 max-w-7xl mx-auto space-y-6">
  <%= turbo_frame_tag "admin_organizations_list" do %>
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden" data-controller="search-filter">

      <div class="p-6 border-b border-slate-200 lg:flex lg:items-center lg:justify-between bg-slate-50/50 gap-4">
        <div class="min-w-0 flex-1">
          <h2 class="text-xl font-bold text-slate-900 tracking-tight">Organizations</h2>
          <p class="mt-1 text-sm text-slate-500">
            Managing <span id="organization_count" class="font-semibold text-slate-700"><%= @organizations.count %></span> registered enterprise profiles.
          </p>
        </div>

        <div class="mt-4 lg:mt-0 flex flex-col sm:flex-row gap-3 w-full lg:w-auto items-stretch sm:items-center">
          <div class="relative w-full sm:w-64">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
              <svg class="h-5 w-5 text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
              </svg>
            </div>
            <input type="text"
                    placeholder="Search organizations..."
                    data-action="input->search-filter#search"
                    data-search-filter-target="input"
                    class="block w-full rounded-lg border border-slate-300 bg-white py-2 pl-10 pr-3 text-sm placeholder-slate-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none shadow-sm transition-colors duration-200">
          </div>

          <%= link_to new_admin_organization_path,
            data: { turbo_frame: "modal", turbo_prefetch: "false" },
            class: "inline-flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 gap-2 whitespace-nowrap transition-colors" do %>
            <svg class="h-5 w-5 text-white/90" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
            </svg>
            Add Organization
          <% end %>

        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-left">
          <thead class="bg-slate-50">
            <tr>
              <th scope="col" class="py-3.5 pl-6 pr-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Organization Name</th>
              <th scope="col" class="px-3 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-600">Primary Owner</th>
              <th scope="col" class="px-3 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-600">Management Team</th>
            </tr>
          </thead>
          <tbody id="organizations_table_body" data-search-filter-target="list" class="divide-y divide-slate-200 bg-white">
            <%= render @organizations %>
          </tbody>
        </table>
      </div>

      <% if @organizations.empty? %>
        <div class="text-center py-12 bg-white">
          <svg class="mx-auto h-12 w-12 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
          <h3 class="mt-2 text-sm font-semibold text-slate-900">No organizations</h3>
          <p class="mt-1 text-sm text-slate-500">Get started by creating a new organization instance.</p>
        </div>
      <% end %>

    </div>
  <% end %>
</div>
