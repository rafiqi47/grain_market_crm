<!-- app/views/products/_form.html.erb -->
<%= form_with(model: product, class: "space-y-5") do |f| %>
  <% if product.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 p-3.5 rounded-lg text-xs font-medium">
      <%= product.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <!-- Row 1: Product Name -->
  <div class="space-y-1.5">
    <%= f.label :name, "Product Name", class: "block text-[11px] font-bold tracking-wider text-gray-500 uppercase" %>
    <%= f.text_field :name, 
        class: "block w-full rounded-lg border border-gray-200 bg-gray-50/50 px-3.5 py-2 text-sm text-gray-900 placeholder-gray-400 shadow-sm transition-all focus:border-indigo-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500", 
        placeholder: "e.g. Premium Basmati Seed X10",
        required: true %>
  </div>

  <div>
    <%= f.label :slug, "Product Slug (Urdu Script)", class: "block text-xs font-semibold text-gray-600 uppercase" %>
    <%= f.text_field :slug, 
                    placeholder: "مثال: ڈی-اے-پی", 
                    dir: "rtl", 
                    class: "mt-1 block w-full rounded border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm font-medium text-right", 
                    required: true %>
    <p class="text-[10px] text-gray-400 mt-0.5">Enter the product identifier using Urdu characters. Spaces will turn into hyphens automatically.</p>
  </div>

  <!-- Row 2: Product SKU / Stock Code -->
  <div class="space-y-1.5">
    <%= f.label :sku, "Product SKU / Stock Code", class: "block text-[11px] font-bold tracking-wider text-gray-500 uppercase" %>
    <%= f.text_field :sku, 
        class: "block w-full rounded-lg border border-gray-200 bg-gray-50/50 px-3.5 py-2 text-sm text-gray-900 placeholder-gray-400 shadow-sm transition-all focus:border-indigo-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500",
        placeholder: "e.g. BSM-SEED-09" %>
  </div>

  <!-- Row 3: Category Group Selector (With Blocked Prompt Target) -->
  <div class="space-y-1.5">
    <%= f.label :category, "Category Group", class: "block text-[11px] font-bold tracking-wider text-gray-500 uppercase" %>
    <div class="relative">
      <%= f.select :category, 
          Product.categories.keys.map { |c| [c.humanize, c] }, 
          { prompt: "Select a product category", selected: product.new_record? ? nil : product.category }, 
          { class: "block w-full appearance-none rounded-lg border border-gray-200 bg-gray-50/50 px-3.5 py-2 pr-10 text-sm text-gray-900 shadow-sm transition-all focus:border-indigo-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500 cursor-pointer", required: true } %>
      <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3.5 text-gray-400">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Row 4: Assigned Supplier Selector -->
  <div class="space-y-1.5">
    <%= f.label :supplier_id, "Assigned Supplier", class: "block text-[11px] font-bold tracking-wider text-gray-500 uppercase" %>
    <div class="relative">
      <%= f.collection_select :supplier_id, 
          current_user.organization.suppliers.order(name: :asc), 
          :id, 
          :name, 
          { prompt: "Select a registered supplier" }, 
          { class: "block w-full appearance-none rounded-lg border border-gray-200 bg-gray-50/50 px-3.5 py-2 pr-10 text-sm text-gray-900 shadow-sm transition-all focus:border-indigo-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500 cursor-pointer", required: true } %>
      <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3.5 text-gray-400">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
        </svg>
      </div>
    </div>
  </div>

  <div class="space-y-1.5">
    <%= f.label :reorder_threshold, "Reorder Safety Threshold (Bags / Units / Kg's)", class: "block text-[11px] font-bold tracking-wider text-gray-500 uppercase" %>
    <%= f.number_field :reorder_threshold, 
        class: "block w-full rounded-lg border border-gray-200 bg-gray-50/50 px-3.5 py-2 text-sm text-gray-900 placeholder-gray-400 shadow-sm transition-all focus:border-indigo-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500", 
        placeholder: "e.g. 50",
        min: 0,
        required: true %>
    <p class="text-[11px] text-gray-400 mt-0.5">The system uses this to automatically compile a replenishment list on your main dashboard when aggregate quantities drop below this value.</p>
  </div>

  <!-- Actions Panel -->
  <div class="flex justify-end gap-2.5 pt-4 border-t border-gray-100">
    <%= link_to "Cancel", products_path, 
        class: "px-4 py-2 text-xs font-semibold text-gray-600 bg-gray-50 rounded-lg border border-gray-200 shadow-sm hover:bg-gray-100 transition-colors", 
        data: { turbo_frame: "_top" } %>
        
    <%= f.submit product.new_record? ? "Catalog Product" : "Update Details", 
        class: "px-4 py-2 text-xs font-semibold text-white bg-indigo-600 rounded-lg shadow-sm hover:bg-indigo-700 transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
  </div>
<% end %>
