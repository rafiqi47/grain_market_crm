<div class="bg-white shadow rounded-lg overflow-hidden border border-gray-200">
  <table id="products_catalog_table" class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Product</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Supplier</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total Available Qty</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Batches Details</th>
        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% if products.any? %>
        <% products.each do |product| %>
          <% is_commodity = %w[seed oil_cake wanda].include?(product.category.to_s) %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center space-x-2">
                <!-- English Name -->
                <span class="font-medium text-gray-900 capitalize"><%= product.name %></span>
                
                <% if product.respond_to?(:slug) && product.slug.present? %>
                  <!-- Separator -->
                  <span class="text-gray-300">/</span>
                  <!-- Isolated Urdu Slug Text Segment -->
                  <span class="inline-block px-1.5 py-0.5 text-[11px] font-medium bg-slate-100 text-slate-800 rounded tracking-wide font-sans" dir="rtl">
                    <%= product.slug %>
                  </span>
                <% end %>
              </div>
              <div class="text-xs text-gray-500 mt-0.5">SKU: <%= product.sku.presence || 'N/A' %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800 uppercase">
                <%= product.category.humanize %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= product.supplier.name %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900">
              <%= product.total_quantity_on_hand %> <%= is_commodity ? 'KGs' : 'bags' %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">
              <div class="flex items-center gap-3">
                <details class="cursor-pointer group flex-1" open>
                  <summary class="text-indigo-600 hover:text-indigo-900 font-medium">View Batches Breakdown</summary>
                  <ul class="mt-2 space-y-1 bg-gray-50 p-3 rounded border border-gray-200 text-xs">
                    <% if product.product_batches.active.any? %>
                      <% product.product_batches.active.each do |batch| %>
                        <li class="flex items-center justify-between py-1 border-b last:border-0 border-gray-200 gap-4">
                          <div class="flex flex-col gap-0.5">
                            <span class="font-semibold text-gray-700">Lot: <%= batch.batch_number.presence || 'Loose Stock' %></span>
                            <div class="flex gap-2 text-[10px] text-gray-500">
                              <span>Qty: <b class="text-gray-800"><%= batch.quantity_on_hand %></b> / <%= batch.initial_quantity %> <%= is_commodity ? 'KGs' : 'bags' %></span>
                              <% if batch.expiry_date.present? %>
                                <span class="text-red-600">Exp: <%= batch.expiry_date %></span>
                              <% end %>
                            </div>
                          </div>
                          <div class="flex items-center gap-2 flex-shrink-0">
                            <%= link_to "Edit", edit_product_product_batch_path(product, batch), 
                                        class: "text-indigo-600 hover:text-indigo-900 font-medium", 
                                        data: { turbo_frame: "modal" } %>
                            <%= link_to "Delete", product_product_batch_path(product, batch), 
                              class: "text-red-600 hover:text-red-900 font-medium",
                              data: {
                                turbo_method: :delete,
                                turbo_confirm: "Are you sure you want to delete batch #{batch.batch_number.presence || 'Loose Stock'}? This will permanently adjust available inventory counts." 
                              } %>
                          </div>
                        </li>
                      <% end %>
                    <% else %>
                      <li class="text-gray-400 italic">No active lots listed.</li>
                    <% end %>
                  </ul>
                </details>
                <%= link_to is_commodity ? "+ Add Weight" : "+ Add Lot", new_product_product_batch_path(product), class: "text-xs text-emerald-600 border border-emerald-300 bg-emerald-50 px-2 py-1 rounded hover:bg-emerald-100 transition-colors whitespace-nowrap", data: { turbo_frame: "modal" } %>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to "Edit", edit_product_path(product), class: "text-indigo-600 hover:text-indigo-900 transition-colors mr-2", data: { turbo_frame: "modal" } %>
              <%= link_to "Delete", product_path(product),
                data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                class: "text-red-600 hover:text-red-900 transition-colors" %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="6" class="px-6 py-10 text-center text-sm text-gray-500 bg-gray-50">
            No items logged in the product portfolio catalog yet.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
