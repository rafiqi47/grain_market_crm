<!-- app/views/products/index.html.erb -->
<div class="container mx-auto px-6 py-8">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Product Portfolio Catalog</h1>
      <p class="text-xs text-gray-500 mt-1">Manage physical inventory categories, tracking profiles, and associated distribution lots.</p>
    </div>
    <%= link_to "Catalog Product", new_product_path, class: "px-4 py-2 bg-indigo-600 text-white text-xs font-semibold rounded shadow hover:bg-indigo-700 transition-colors", data: { turbo_frame: "modal" } %>
  </div>

  <div id="products_catalog_table">
    <%= render "table", products: @products %>
  </div>
</div>

<%= turbo_frame_tag "modal" %>
