<nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <div class="flex items-center">
        <%= link_to root_path, class: "flex-shrink-0 flex items-center gap-2" do %>
          <span class="text-xl font-bold text-emerald-600 tracking-tight">GrainMarket</span>
          <span class="bg-emerald-100 text-emerald-800 text-xs font-semibold px-2 py-0.5 rounded">CRM</span>
        <% end %>
      </div>

      <div class="flex items-center gap-4">
        <% if user_signed_in? %>
          <span class="text-sm text-gray-600 hidden sm:inline">
            Logged in as: <strong class="font-medium text-gray-900"><%= current_user.email %></strong>
          </span>

          <%= link_to "Dashboard", dashboard_path, class: "text-sm font-medium text-gray-700 hover:text-emerald-600 transition" %>

          <%= link_to "Log out", destroy_user_session_path,
                      data: { turbo_method: :delete },
                      class: "text-sm font-medium text-red-600 hover:text-red-700 transition" %>
        <% else %>
          <%= link_to "Sign In", new_user_session_path,
            class: "inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-emerald-600 hover:bg-emerald-700 shadow-sm transition" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
