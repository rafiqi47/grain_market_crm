<nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <div class="flex items-center">
        <%= link_to root_path, class: "flex-shrink-0 flex items-center gap-2" do %>
          <span class="text-xl font-bold text-emerald-600 tracking-tight">GrainMarket</span>
          <span class="bg-emerald-100 text-emerald-800 text-xs font-semibold px-2 py-0.5 rounded">CRM</span>
        <% end %>
      </div>

      <div class="flex items-center gap-4">
        <% if user_signed_in? %>
          <span class="text-sm text-gray-600 hidden sm:inline">
            Logged in as: <strong class="font-medium text-gray-900"><%= current_user.full_name %></strong>
          </span>

          <% if current_user.owner? %>
            <%= link_to edit_organization_settings_path, class: "p-1.5 text-gray-500 hover:text-gray-900 hover:bg-gray-100 rounded-lg transition-colors", title: "Organization Settings" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            <% end %>
          <% end %>

          <%= button_to destroy_user_session_path, method: :delete, class: "p-0 bg-transparent border-0" do %>
            <%= custom_button(color: "error", variant: "contained", is_submit: true) { "Log out" } %>
          <% end %>
        <% else %>
          <%= link_to new_user_session_path do %>
            <%= custom_button(color: "main", variant: "contained") { "Sign In" } %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
