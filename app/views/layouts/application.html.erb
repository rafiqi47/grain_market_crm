<!DOCTYPE html>
<html class="h-full overflow-hidden"> <%# Force HTML tag to respect screen restrictions %>
  <head>
    <title>GrainMarketCRM</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_importmap_tags %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400;700&display=swap" rel="stylesheet">
  </head>

  <body class="bg-gray-50 text-gray-900 antialiased h-screen max-h-screen w-screen overflow-hidden m-0 p-0 flex flex-col"
        data-controller="loader"
        data-action="turbo:click->loader#show turbo:load->loader#hide turbo:frame-load->loader#hide">

    <%= render "components/loader" %>

    <%# The navbar & flash messages stay outside the flexible remaining space %>
    <div class="flex-shrink-0">
      <%= render "layouts/navbar" %>
      <%= render "layouts/flash" %>
    </div>

    <%#
      Condition: Display the sidebar layout ONLY if a user is signed in
      AND they are NOT looking at the public home/landing page.
    %>
    <% if user_signed_in? && !(controller_name == 'home' && action_name == 'index') %>
      <%= render "layouts/secondary_nav" %>
      <main class="flex-grow min-h-0 overflow-y-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
          <%= yield %>
        </div>
      </main>
    <% else %>
      <main class="flex-grow min-h-0 h-full overflow-y-auto">
        <%= yield %>
      </main>
    <% end %>

    <%= turbo_frame_tag "modal" %>
  </body>
</html>
