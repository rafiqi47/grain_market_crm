<!DOCTYPE html>
<html>
  <head>
    <title>GrainMarketCRM</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %> <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  </head>

  <body class="bg-gray-50 text-gray-900 antialiased min-h-screen flex flex-col">
    <%= render "layouts/navbar" %>

    <div id="flash-messages" class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 mt-4">
      <% flash.each do |type, message| %>
        <div data-controller="dismiss" class="flex justify-between items-center p-4 rounded-md mb-4 text-sm font-medium shadow-sm <%= type == 'alert' ? 'bg-red-50 text-red-800 border border-red-200' : 'bg-emerald-50 text-emerald-800 border border-emerald-200' %>">
          <span><%= message %></span>

          <button data-action="click->dismiss#dismiss" class="cursor-pointer ml-4 text-lg font-bold opacity-60 hover:opacity-100 transition-opacity">
            &times;
          </button>
        </div>
      <% end %>
    </div>

    <main class="flex-grow">
      <%= yield %>
    </main>
  </body>
</html>
