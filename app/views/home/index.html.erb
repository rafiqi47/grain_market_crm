<div class="h-screen w-full overflow-hidden">
  <div class="relative flex items-center justify-center h-full w-full bg-green-50">
    <div class="absolute inset-0 z-0 opacity-40">
      <%= image_tag "grain_market_hero.png",
          alt: "Grain Market CRM Illustration",
          class: "w-full h-full object-cover" %>
    </div>

    <div class="relative z-10 text-center px-4 grid grid-cols-1 gap-20">
      <h1 class="text-5xl md:text-6xl font-extrabold text-green-900 mb-6">
        Modernizing the Grain Market
      </h1>
      <p class="text-xl text-green-700 mb-8 max-w-2xl mx-auto">
        Streamline your operations, manage inventory, and connect with your market.
        The CRM built specifically for grain traders and managers.
      </p>

      <div class="space-x-4">
        <% if user_signed_in? %>
          <%= link_to "Go to Dashboard", role_based_dashboard_path(current_user),
              data: { turbo_prefetch: "false" },
              class: "bg-green-600 hover:bg-green-700 text-white px-8 py-3 rounded-lg font-semibold transition" %>
        <% else %>
          <%= link_to "Sign In", new_user_session_path,
              class: "bg-green-600 hover:bg-green-700 text-white px-8 py-3 rounded-lg font-semibold transition" %>
          <%= link_to "Learn More", "#",
              class: "bg-white border-2 border-green-600 text-green-600 hover:bg-green-50 px-8 py-3 rounded-lg font-semibold transition" %>
        <% end %>
      </div>
    </div>
  </div>
</div>

