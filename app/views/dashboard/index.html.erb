<div class="container mx-auto px-6 py-8 max-w-7xl">
  
  <div class="border-b border-gray-200 pb-5 mb-8 flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-gray-900">Dashboard Overview</h1>
      <p class="text-sm text-gray-500 mt-1">Enterprise terminal for <span class="font-semibold text-indigo-600"><%= current_user.organization.name %></span></p>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-10">
    <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <span class="p-1.5 rounded-md bg-red-50 text-red-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
        </span>
        <div>
          <h2 class="text-base font-bold text-gray-900">Quality Control & Expiration Monitoring</h2>
          <p class="text-xs text-gray-500">Batches requiring active allocation or stock rotation strategies.</p>
        </div>
      </div>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800">
        <%= @unread_alerts.count %> flagged items
      </span>
    </div>

    <div id="inventory_alerts_list" class="divide-y divide-gray-100">
      <% if @unread_alerts.any? %>
        <%= render partial: "inventory_alerts/alert", collection: @unread_alerts, as: :alert %>
      <% else %>
        <div id="no_alerts_message" class="px-6 py-12 text-center text-sm text-gray-500 bg-white">
          <span class="block font-medium text-gray-700">All inventories clear</span>
        </div>
      <% end %>
    </div>
  </div>

  <%= turbo_frame_tag "procurement_checklist" do %>
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-10">
      <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="p-1.5 rounded-md bg-amber-50 text-amber-600">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
            </svg>
          </span>
          <div>
            <h2 class="text-base font-bold text-gray-900">Dashboard Procurement Checklist</h2>
            <p class="text-xs text-gray-500">Automated safety threshold verification for active sowing windows.</p>
          </div>
        </div>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">
          <%= @low_stock_products.size %> Alerts Active
        </span>
      </div>

      <div class="divide-y divide-gray-100">
        <% if @low_stock_products.any? %>
          <% @low_stock_products.each do |product| %>
            <div class="px-6 py-4 bg-amber-50/40 hover:bg-amber-50/70 transition flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold uppercase px-2 py-0.5 rounded bg-amber-200 text-amber-900 tracking-wide">Low Stock</span>
                  <span class="font-bold text-gray-900 text-lg"><%= product.name %></span>
                  <span class="text-xs text-gray-400 bg-gray-100 px-2 py-0.5 rounded font-mono"><%= product.category.titleize %></span>
                </div>
                <p class="text-sm text-gray-600 mt-1.5">
                  Current Combined Quantity: <span class="font-bold text-red-600"><%= product.total_quantity_on_hand %> Bags</span> 
                  <span class="text-gray-400 mx-1">|</span> Safety Threshold: <span class="font-medium text-gray-700"><%= product.reorder_threshold %> Bags</span>
                </p>
              </div>

              <div class="sm:text-right bg-white p-3 rounded-lg border border-gray-100 shadow-sm max-w-sm">
                <span class="block text-[10px] uppercase tracking-wider text-gray-400 font-bold">Suggested Procurement Action</span>
                <p class="text-sm font-medium text-gray-900 mt-0.5">
                  Order minimum <span class="text-emerald-700 font-extrabold text-base"><%= product.suggested_reorder_quantity %> bags</span> from <span class="font-semibold text-indigo-600 underline decoration-indigo-300 decoration-2"><%= product.supplier.name %></span>.
                </p>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="px-6 py-12 text-center text-sm text-gray-500 bg-white">
            <svg class="mx-auto h-8 w-8 text-emerald-500 mb-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="block font-medium text-gray-700">All product lines are adequately stocked for active sowing windows.</span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

</div>

<%= turbo_frame_tag "modal" %>
