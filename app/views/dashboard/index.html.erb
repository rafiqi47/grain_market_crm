<!-- Khata Engine Stats -->
  <div class="mb-10">
    <div class="border-b border-gray-200 pb-3 mb-6 flex items-center gap-2">
      <span class="p-1.5 rounded-md bg-green-50 text-green-600">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
      </span>
      <h2 class="text-base font-bold text-gray-900">Khata & Ledger Overview</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <!-- Farmers -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-5 py-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
          <h3 class="font-semibold text-gray-900 text-sm">Farmers Khata</h3>
          <%= link_to "View All", farmers_path, class: "text-xs text-green-600 hover:underline" %>
        </div>
        <div class="px-5 py-4 space-y-3">
          <div class="flex justify-between text-sm">
            <span class="text-gray-500">Total Farmers</span>
            <span class="font-semibold text-gray-900"><%= @total_farmers %></span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-gray-500">We owe farmers</span>
            <span class="font-semibold text-green-700">Rs. <%= number_with_delimiter(@farmers_we_owe.round(2)) %></span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-gray-500">Farmers owe us</span>
            <span class="font-semibold text-red-600">Rs. <%= number_with_delimiter(@farmers_owe_us.round(2)) %></span>
          </div>
          <div class="flex justify-between text-sm border-t border-gray-100 pt-3">
            <span class="text-gray-500">Net position</span>
            <% net_farmer = @farmers_we_owe - @farmers_owe_us %>
            <span class="font-bold <%= net_farmer >= 0 ? 'text-green-700' : 'text-red-600' %>">
              Rs. <%= number_with_delimiter(net_farmer.abs.round(2)) %>
              <span class="text-xs font-normal"><%= net_farmer >= 0 ? "(we owe)" : "(owed to us)" %></span>
            </span>
          </div>
          <div class="flex justify-between text-sm border-t border-gray-100 pt-3">
            <span class="text-gray-500">Bardaana balance</span>
            <span class="font-medium text-gray-700"><%= @total_bardaana_with_farmers %> bags</span>
          </div>
        </div>
      </div>

      <!-- Trading Partners -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-5 py-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
          <h3 class="font-semibold text-gray-900 text-sm">Trading Partners</h3>
          <%= link_to "View All", trading_partners_path, class: "text-xs text-blue-600 hover:underline" %>
        </div>
        <div class="px-5 py-4 space-y-3">
          <div class="flex justify-between text-sm">
            <span class="text-gray-500">Total Partners</span>
            <span class="font-semibold text-gray-900"><%= @total_trading_partners %></span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-gray-500">We owe partners</span>
            <span class="font-semibold text-red-600">Rs. <%= number_with_delimiter(@partners_we_owe.round(2)) %></span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-gray-500">Partners owe us</span>
            <span class="font-semibold text-green-700">Rs. <%= number_with_delimiter(@partners_owe_us.round(2)) %></span>
          </div>
          <div class="flex justify-between text-sm border-t border-gray-100 pt-3">
            <span class="text-gray-500">Net position</span>
            <% net_partner = @partners_owe_us - @partners_we_owe %>
            <span class="font-bold <%= net_partner >= 0 ? 'text-green-700' : 'text-red-600' %>">
              Rs. <%= number_with_delimiter(net_partner.abs.round(2)) %>
              <span class="text-xs font-normal"><%= net_partner >= 0 ? "(owed to us)" : "(we owe)" %></span>
            </span>
          </div>
          <div class="flex justify-between text-sm border-t border-gray-100 pt-3">
            <span class="text-gray-500">Bardaana balance</span>
            <span class="font-medium text-gray-700"><%= @total_bardaana_with_partners %> bags</span>
          </div>
        </div>
      </div>

      <!-- Crop Stock -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-5 py-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
          <h3 class="font-semibold text-gray-900 text-sm">Crop Stock</h3>
          <%= link_to "View All", crops_path, class: "text-xs text-yellow-600 hover:underline" %>
        </div>
        <div class="px-5 py-4 space-y-3">
          <% if @crops.any? %>
            <% @crops.each do |crop| %>
              <div class="flex justify-between text-sm">
                <span class="text-gray-600"><%= crop.name %></span>
                <span class="font-medium <%= crop.quantity_on_hand.zero? ? 'text-gray-400' : 'text-gray-900' %>">
                  <%= crop.quantity_on_hand_formatted %>
                </span>
              </div>
            <% end %>
            <div class="flex justify-between text-sm border-t border-gray-100 pt-3">
              <span class="text-gray-500">Total stock</span>
              <span class="font-bold text-gray-900">
                <% total_maund = (@total_crop_stock_kg / 40).to_i %>
                <% total_kg = (@total_crop_stock_kg % 40).round(2) %>
                <%= total_maund %> Maund <%= total_kg %> KG
              </span>
            </div>
          <% else %>
            <p class="text-sm text-gray-400 text-center py-4">No crops added yet.</p>
          <% end %>
        </div>
      </div>

    </div>
  </div>
  